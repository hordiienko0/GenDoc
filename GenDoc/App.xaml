<Application x:Class="GenDoc.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GenDoc.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/UnitEmblem.xaml"/>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
            <conv:FractionToGridLengthConverter x:Key="FractionToGridLength"/>
            <conv:OccupancyToWidthConverter x:Key="OccupancyToWidth"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>