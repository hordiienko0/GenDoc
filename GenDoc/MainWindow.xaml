<Window x:Class="GenDoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:GenDoc.ViewModels.Shell"
        xmlns:recipientsVm="clr-namespace:GenDoc.ViewModels.Recipients"
        xmlns:recipientsView="clr-namespace:GenDoc.Views.Recipients"
        xmlns:importVm="clr-namespace:GenDoc.ViewModels.Import"
        xmlns:importView="clr-namespace:GenDoc.Views.Import"
        xmlns:templatesVm="clr-namespace:GenDoc.ViewModels.Templates"
        xmlns:templatesView="clr-namespace:GenDoc.Views.Templates"
        xmlns:auditVm="clr-namespace:GenDoc.ViewModels.Audit"
        xmlns:auditView="clr-namespace:GenDoc.Views.Audit"
        xmlns:settingsVm="clr-namespace:GenDoc.ViewModels.Settings"
        xmlns:settingsView="clr-namespace:GenDoc.Views.Settings"
        xmlns:generationVm="clr-namespace:GenDoc.ViewModels.Generation"
        xmlns:generationView="clr-namespace:GenDoc.Views.Generation"
        xmlns:roomsVm="clr-namespace:GenDoc.ViewModels.Rooms"
        xmlns:roomsView="clr-namespace:GenDoc.Views.Rooms"
        xmlns:personnelVm="clr-namespace:GenDoc.ViewModels.Personnel"
        xmlns:personnelView="clr-namespace:GenDoc.Views.Personnel"
        xmlns:trashVm="clr-namespace:GenDoc.ViewModels.Trash"
        xmlns:trashView="clr-namespace:GenDoc.Views.Trash"
        xmlns:archiveVm="clr-namespace:GenDoc.ViewModels.Archive"
        xmlns:archiveView="clr-namespace:GenDoc.Views.Archive"
        xmlns:completenessVm="clr-namespace:GenDoc.ViewModels.Completeness"
        xmlns:completenessView="clr-namespace:GenDoc.Views.Completeness"
        xmlns:intakesVm="clr-namespace:GenDoc.ViewModels.Intakes"
        xmlns:intakesView="clr-namespace:GenDoc.Views.Intakes"
        xmlns:staffVm="clr-namespace:GenDoc.ViewModels.Staff"
        xmlns:staffView="clr-namespace:GenDoc.Views.Staff"
        Style="{StaticResource {x:Type Window}}"
        Title="GenDoc - Облік особового складу" Height="720" Width="1180"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type shell:PlaceholderViewModel}">
            <TextBlock Text="{Binding Title, StringFormat='Розділ «{0}» у розробці'}"
                       FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type recipientsVm:RecipientsViewModel}">
            <recipientsView:RecipientsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type importVm:ImportViewModel}">
            <importView:ImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type templatesVm:TemplatesViewModel}">
            <templatesView:TemplatesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type auditVm:AuditLogViewModel}">
            <auditView:AuditLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
            <settingsView:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type generationVm:GenerationViewModel}">
            <generationView:GenerationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type roomsVm:RoomsViewModel}">
            <roomsView:RoomsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type personnelVm:PersonnelViewModel}">
            <personnelView:PersonnelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type trashVm:TrashViewModel}">
            <trashView:TrashView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type archiveVm:ArchiveViewModel}">
            <archiveView:ArchiveView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type completenessVm:CompletenessViewModel}">
            <completenessView:CompletenessView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type intakesVm:IntakesViewModel}">
            <intakesView:IntakesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type staffVm:StaffViewModel}">
            <staffView:StaffView/>
        </DataTemplate>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NavyMidBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Кнопка закріплення/згортання меню - на темному тлі панелі -->
        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NavyMidBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundBrush}">

        <!-- Титульна панель -->
        <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource NavyDeepBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="{StaticResource UnitEmblemImage}" Width="18" Height="18"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding WindowTitleText}" Margin="8,0,0,0"
                               FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeRestoreButton" Content="&#xE922;" Style="{StaticResource WindowButtonStyle}" Click="MaximizeRestoreButton_Click"/>
                    <Button Content="&#xE711;" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рядок меню -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл" Click="MenuItem_Click"/>
            <MenuItem Header="Правка" Click="MenuItem_Click"/>
            <MenuItem Header="Вигляд" Click="MenuItem_Click"/>
            <MenuItem Header="Сервіс" Click="MenuItem_Click"/>
            <MenuItem Header="Довідка" Click="MenuItem_Click"/>
        </Menu>

        <Border DockPanel.Dock="Bottom" Height="24" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusBarUserText}"
                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBarIntakeText}"
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusBarConnectionText}"
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <!-- Скільки місця меню ЗАБИРАЄ: закріплене - повну ширину,
                     згорнуте - лише смужку іконок. -->
                <ColumnDefinition Width="{Binding SidebarColumnWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" Margin="24"/>

            <!-- Панель лежить ПОВЕРХ обох колонок і вирівняна вліво: коли вона
                 незакріплена, розкриття наїжджає на вміст, а не розсуває його
                 (інакше весь розділ перебудовувався б від наведення миші). -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="10"
                    HorizontalAlignment="Left" Width="{Binding SidebarWidth}"
                    Background="{StaticResource NavyBrush}"
                    MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave">
                <DockPanel>

                    <!-- Шапка: емблема + назва частини + закріплення панелі -->
                    <Border DockPanel.Dock="Top" Padding="10,12"
                            BorderBrush="{StaticResource SidebarDividerBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <!-- Кнопка закріплення видима лише в розкритому стані:
                                 у смужці для неї немає місця, а розкрити її можна
                                 наведенням. -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource SidebarToggleButtonStyle}"
                                    Content="{Binding SidebarToggleIcon}"
                                    ToolTip="{Binding SidebarToggleTooltip}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/>

                            <Image Source="{StaticResource UnitEmblemImage}" Width="32" Height="32"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SidebarUnitShortName}" FontSize="12.5"
                                           FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SidebarUnitFullName}" FontSize="10.5"
                                           Foreground="{StaticResource MenuTextBrush}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasSidebarUnitFullName, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type shell:NavigationGroup}">
                                <StackPanel Margin="0,4,0,8">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type shell:NavigationItem}">
                                                <Button Style="{StaticResource NavItemButtonStyle}"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip="{Binding Title}"
                                                        Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Іконка розділу: у згорнутій смужці від пункту
                                                             лишається тільки вона, тому фіксованої ширини
                                                             й по центру смужки. -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                                   Width="22" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Border Grid.Column="2" Padding="5,1"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource SkyBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BadgeKind}" Value="Attention">
                                                                            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BadgeCount}" FontSize="10" FontWeight="Bold"
                                                                       HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding BadgeKind}" Value="Attention">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Background="{StaticResource SidebarDividerBrush}" Margin="15,10,15,0"
                                            Visibility="{Binding ShowDividerAfter, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
