<Window x:Class="GenDoc.Views.Archive.DeleteDocumentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Видалення документів" Width="440" SizeToContent="Height"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <CheckBox Content="{Binding AllVersionsLabel}" IsChecked="{Binding DeleteAllVersions}" Margin="0,12,0,0"
                  Visibility="{Binding ShowAllVersionsOption, Converter={StaticResource BoolToVisibility}}"/>

        <TextBlock Text="Документи потрапляють у кошик, звідки їх можна відновити." FontSize="11.5" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Content="Видалити" Margin="8,0,0,0" MinWidth="100" Command="{Binding OkCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
