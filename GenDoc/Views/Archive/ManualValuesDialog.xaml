<Window x:Class="GenDoc.Views.Archive.ManualValuesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Ручні поля шаблонів" Width="440" SizeToContent="Height" MaxHeight="600"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"/>
            <Button Content="Продовжити" Margin="8,0,0,0" MinWidth="110" Command="{Binding OkCommand}"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Одна форма на весь батч - значення підставляться в усі документи"
                   FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Form}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Label}" ToolTip="{Binding Tag}" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>

                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Дата - дд.мм.рррр; період - дд.мм.рррр-дд.мм.рррр"/>
<Grid Style="{StaticResource PeriodPickersStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding PeriodFrom}" ToolTip="З"/><TextBlock Grid.Column="1" Text="–" Margin="6,0" VerticalAlignment="Center"/><DatePicker Grid.Column="2" SelectedDate="{Binding PeriodTo}" ToolTip="По"/></Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,6,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Signer}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Підписант" FontSize="11.5" Margin="0,0,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Signer.Options}" DisplayMemberPath="DisplayLabel"
                              SelectedItem="{Binding Signer.Selected, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Margin="0,6,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CourseOfficer}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Курсовий офіцер" FontSize="11.5" Margin="0,0,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding CourseOfficer.Options}" DisplayMemberPath="DisplayLabel"
                              SelectedItem="{Binding CourseOfficer.Selected, Mode=TwoWay}"/>
                    <TextBlock Text="Немає ні курсового офіцера, ні начальника курсів у налаштуваннях - відомості з підписом не сформуються"
                               Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CourseOfficer.Options.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
