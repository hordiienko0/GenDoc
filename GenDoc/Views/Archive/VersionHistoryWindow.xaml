<Window x:Class="GenDoc.Views.Archive.VersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Історія версій" Width="580" Height="620"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Історія версій" FontSize="14.5" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding HeaderText}" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <Button Content="Закрити" HorizontalAlignment="Right" MinWidth="100"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CloseCommand}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource SkySoftBrush}" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource NavyBrush}"/>
                                        </Border>
                                        <TextBlock FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding DateText, Mode=OneWay}"/>
                                            <Run Text=" · " Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text="{Binding Author, Mode=OneWay}"/>
                                            <Run Text=" · " Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text="{Binding SizeText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=" · " Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                        <Border Background="{StaticResource AccentSoftBrush}" Padding="6,1" Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="актуальна" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Відкрити" Style="{StaticResource TextLinkButtonStyle}" FontSize="11.5"
                                                IsEnabled="{Binding CanOpen}"
                                                Command="{Binding Owner.OpenVersionCommand}" CommandParameter="{Binding}"/>
                                        <Button Content="Зберегти як…" Style="{StaticResource TextLinkButtonStyle}" FontSize="11.5"
                                                Margin="12,0,0,0" IsEnabled="{Binding CanOpen}"
                                                Command="{Binding Owner.SaveVersionAsCommand}" CommandParameter="{Binding}"/>
                                        <Button Content="Зробити актуальною" Style="{StaticResource TextLinkButtonStyle}" FontSize="11.5"
                                                Margin="12,0,0,0" IsEnabled="{Binding CanMakeCurrent}"
                                                Command="{Binding Owner.MakeCurrentCommand}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="ВКЛАДЕННЯ" FontSize="11" FontWeight="Bold" Margin="0,16,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Text="Вкладень немає" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding VersionText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding DateText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding NoteText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Content="Відкрити" Style="{StaticResource TextLinkButtonStyle}" FontSize="11.5"
                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Зберегти як…" Style="{StaticResource TextLinkButtonStyle}" FontSize="11.5"
                                                Margin="12,0,0,0"
                                                Command="{Binding DataContext.SaveAttachmentAsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Видалити" Style="{StaticResource TextLinkButtonStyle}" FontSize="11.5"
                                                Margin="12,0,0,0" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
