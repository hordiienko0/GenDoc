<UserControl x:Class="GenDoc.Views.Completeness.CompletenessView"
             x:Name="CompletenessRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="CompletenessView_Loaded">

    <UserControl.Resources>
        <Style x:Key="CompletenessFilterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="GearButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="ToolTip" Value="Вимоги пакета…"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="OutlineWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        </Style>

        <DataTemplate x:Key="CheckBoxHeaderTemplate">
            <CheckBox IsThreeState="True" HorizontalAlignment="Center"
                      IsChecked="{Binding DataContext.HeaderChecked, ElementName=CompletenessRoot, Mode=TwoWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="CheckBoxCellTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="PersonCellTemplate">
            <Border Background="{Binding FirstColumnBackground}" Padding="8,4">
                <StackPanel>
                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubText}" FontSize="10.5" Margin="0,1,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReadinessCellTemplate">
            <StackPanel VerticalAlignment="Center" Margin="8,4">
                <TextBlock Text="{Binding ReadyText}" FontSize="11.5"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border x:Name="Track" Height="4" Background="{StaticResource BorderLineBrush}" Margin="0,3,0,0">
                    <Border HorizontalAlignment="Left" Background="{Binding ReadyBarFill}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource OccupancyToWidth}">
                                <Binding Path="RequiredPresent"/>
                                <Binding Path="RequiredTotal"/>
                                <Binding ElementName="Track" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Комплектність документів" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Хто з набору які документи вже має" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,10"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ComboBox Style="{StaticResource CompletenessFilterComboStyle}" ItemsSource="{Binding IntakeOptions}"
                          SelectedItem="{Binding SelectedIntake}" DisplayMemberPath="Label"/>
                <ComboBox Style="{StaticResource CompletenessFilterComboStyle}" ItemsSource="{Binding PackageOptions}"
                          SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="Label"/>
                <Button Content="⚙ Вимоги" Style="{StaticResource GearButtonStyle}"
                        Command="{Binding OpenRequirementsCommand}"/>
                <TextBox Width="220" Tag="Пошук за ПІБ…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✓ є" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="— немає" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="! застарів" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="(—) опційний відсутній" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{Binding GenerateMissingLabel}" IsEnabled="{Binding CanGenerateMissing}"
                    Command="{Binding GenerateMissingCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="{Binding RegenerateStaleLabel}" IsEnabled="{Binding CanRegenerateStale}"
                    Style="{StaticResource OutlineWarningButtonStyle}"
                    Command="{Binding RegenerateStaleCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Експортувати пакети обраних" IsEnabled="{Binding CanExportSelected}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ExportSelectedCommand}"/>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8"
                        Visibility="{Binding IsFullyComplete, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Пакет повний — усі обов'язкові документи згенеровано" FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="MatrixGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="False"
                              EnableRowVirtualization="True"
                              HeadersVisibility="Column"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Створіть набір, щоб бачити комплектність" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoIntakes, Converter={StaticResource BoolToVisibility}}"/>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding PackageIsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="У пакеті немає шаблонів" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="Вимоги пакета…" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,10,0,0" HorizontalAlignment="Center"
                                Command="{Binding OpenRequirementsCommand}"/>
                    </StackPanel>

                    <TextBlock Text="У наборі ще немає особового складу" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IntakeHasNoPeople, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding FooterText}" FontSize="11.5" Margin="0,8,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
