<Window x:Class="GenDoc.Views.Completeness.PackageRequirementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GenDoc.ViewModels.Completeness"
        Style="{StaticResource {x:Type Window}}"
        Title="Вимоги пакета" Width="860" Height="720" MinWidth="760" MinHeight="480"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="RequirementSegmentStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding PackageName, StringFormat='Вимоги пакета «{0}»'}"
                           FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Які шаблони обов'язкові для кожної категорії придатності" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding PreviewText}" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding ValidationError}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource DangerBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"/>
                    <Button Content="Зберегти" Margin="8,0,0,0" MinWidth="100" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Уся форма прокручується як одне ціле: список росте вниз, а «+ Додати…» іде
             одразу під ним (раніше список займав * і лишав пів вікна порожнім). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="258"/>
                    <ColumnDefinition Width="258"/>
                    <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ШАБЛОН" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="ПРИДАТНІ" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="ОБМЕЖЕНО ПРИДАТНІ" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RequirementTemplateRowViewModel}">
                            <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="258"/>
                                        <ColumnDefinition Width="258"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"><TextBlock.ToolTip><TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value=" (груповий - формується на весь склад у «Генерації»)"/><Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="False"><Setter Property="Text" Value=""/></DataTrigger></Style.Triggers></Style></Run.Style></Run></TextBlock></TextBlock.ToolTip></TextBlock>


                                    <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center">
                                        <Button Content="Обов'язк."
                                                Command="{Binding DataContext.SetRegularCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Regular}" Value="Required">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Опційний"
                                                Command="{Binding DataContext.SetRegularOptionalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Regular}" Value="Optional">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Не потрібен"
                                                Command="{Binding DataContext.SetRegularNaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Regular}" Value="NotApplicable">
                                                            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>

                                    <UniformGrid Grid.Column="2" Columns="3" VerticalAlignment="Center">
                                        <Button Content="Обов'язк."
                                                Command="{Binding DataContext.SetLimitedRequiredCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Limited}" Value="Required">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Опційний"
                                                Command="{Binding DataContext.SetLimitedOptionalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Limited}" Value="Optional">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Не потрібен"
                                                Command="{Binding DataContext.SetLimitedNaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Limited}" Value="NotApplicable">
                                                            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="&#xE70E;" ToolTip="Вище" Style="{StaticResource RowIconButtonStyle}"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="&#xE70D;" ToolTip="Нижче" Style="{StaticResource RowIconButtonStyle}" Margin="2,0,0,0"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="&#xE711;" ToolTip="Прибрати з пакета" Style="{StaticResource RowIconButtonStyle}" Margin="4,0,0,0"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

            </ItemsControl>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <ComboBox Width="300" Tag="Оберіть шаблон…" ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding SelectedTemplateToAdd}"
                          DisplayMemberPath="Name"/>
                <Button Content="+ Додати шаблон" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0" Command="{Binding AddTemplateCommand}" IsEnabled="{Binding CanAddTemplate}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="ВІДОМОСТІ (EXCEL) - ОДИН АРКУШ НА ВЕСЬ СКЛАД" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,8"/>

            <ItemsControl Grid.Row="4" ItemsSource="{Binding ExportRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ExportTemplateLinkRowViewModel}">
                        <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="372"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center">
                                    <Button Content="Усі"
                                            Command="{Binding DataContext.SetFitnessAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Filter}" Value="All">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Придатні"
                                            Command="{Binding DataContext.SetFitnessRegularCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Filter}" Value="RegularOnly">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Обмежено придатні"
                                            Command="{Binding DataContext.SetFitnessLimitedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RequirementSegmentStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Filter}" Value="LimitedOnly">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </UniformGrid>

                                <Button Grid.Column="2" Content="&#xE711;" ToolTip="Прибрати з пакета" Style="{StaticResource RowIconButtonStyle}"
                                        Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.RemoveExportTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                <ComboBox Width="300" Tag="Оберіть відомість…" ItemsSource="{Binding AvailableExportTemplates}" SelectedItem="{Binding SelectedExportTemplateToAdd}"
                          DisplayMemberPath="Name"/>
                <Button Content="+ Додати відомість" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0" Command="{Binding AddExportTemplateCommand}" IsEnabled="{Binding CanAddExportTemplate}"/>
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
