<UserControl x:Class="GenDoc.Views.Generation.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="PackageCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <TextBlock Text="Генерація" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Пакети шаблонів для масової генерації документів"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5" Margin="0,4,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ліва колонка: пакети -->
                <StackPanel Grid.Column="0">
                    <ItemsControl ItemsSource="{Binding Packages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PackageCardStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectPackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TemplateCountDisplay}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="&#xE74D;" Style="{StaticResource RowIconButtonStyle}" ToolTip="Видалити"
                                                Command="{Binding DataContext.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Новий пакет" Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding ShowCreatePackageCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Visibility="{Binding NotCreatingPackage, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Інлайн-форма створення пакета -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="16" Margin="0,4,0,0"
                            Visibility="{Binding IsCreatingPackage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Назва" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding NewPackageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="Опис" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding NewPackageDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Шаблони" Style="{StaticResource FieldLabelStyle}"/>
                            <ItemsControl ItemsSource="{Binding TemplateCheckItems}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Створити" Command="{Binding CreatePackageCommand}"/>
                                <Button Content="Скасувати" Style="{StaticResource OutlineButtonStyle}"
                                        Command="{Binding CancelCreatePackageCommand}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Права панель: обраний пакет -->
                <Grid Grid.Column="2">
                    <TextBlock Text="Оберіть пакет ліворуч або створіть новий" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48"
                               Visibility="{Binding NoSelectedPackage, Converter={StaticResource BoolToVisibility}}"/>

                    <StackPanel Visibility="{Binding HasSelectedPackage, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="Шаблони пакета" Style="{StaticResource SectionTitleStyle}"/>
                        <ItemsControl ItemsSource="{Binding PackageTemplates}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding RecipientCount, StringFormat='Буде згенеровано для {0} осіб'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5" Margin="0,0,0,20"/>

                        <StackPanel Visibility="{Binding HasManualTags, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,20">
                            <TextBlock Text="Значення для цієї генерації" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                    BorderThickness="1" CornerRadius="2" Padding="16">
                                <ItemsControl ItemsSource="{Binding ManualTagInputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Tag}" FontFamily="Consolas"
                                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Обрати папку…" Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding PickOutputFolderCommand}"/>
                            <TextBlock Text="{Binding OutputFolder}" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OutputFolder}"/>
                        </StackPanel>

                        <CheckBox Content="Генерувати повторно вже наявні" IsChecked="{Binding RegenerateExisting}" Margin="0,0,0,20"/>

                        <Button Content="Згенерувати всім" Padding="26,12" Command="{Binding GenerateAllCommand}"
                                HorizontalAlignment="Left"
                                Visibility="{Binding NotBusy, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                    </StackPanel>
                </Grid>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
