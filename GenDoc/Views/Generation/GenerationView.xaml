<UserControl x:Class="GenDoc.Views.Generation.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="PackageCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,1,1,1"/>
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SkySoftBrush}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <TextBlock Text="Генерація" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Пакети шаблонів для масової генерації документів"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ліва колонка: пакети -->
                <StackPanel Grid.Column="0">
                    <ItemsControl ItemsSource="{Binding Packages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PackageCardStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectPackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TemplateCountDisplay}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="&#xE74D;" Style="{StaticResource RowIconButtonStyle}" ToolTip="Видалити"
                                                Command="{Binding DataContext.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Новий пакет" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ShowCreatePackageCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Visibility="{Binding NotCreatingPackage, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Інлайн-форма створення пакета -->
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                            BorderThickness="1" CornerRadius="0" Padding="16" Margin="0,4,0,0"
                            Visibility="{Binding IsCreatingPackage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Назва" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding NewPackageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="Опис" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding NewPackageDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Шаблони" Style="{StaticResource FieldLabelStyle}"/>
                            <ItemsControl ItemsSource="{Binding TemplateCheckItems}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
                                            <Border Background="{StaticResource SkySoftBrush}" CornerRadius="0" Padding="4,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding KindBadge}" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{StaticResource NavyBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Створити" Command="{Binding CreatePackageCommand}"/>
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CancelCreatePackageCommand}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Права панель: обраний пакет -->
                <Grid Grid.Column="2">
                    <!-- Порожній бік екрана більше не мовчить: показує, що
                         запускали минулого разу. Найчастіша дія - знову взятися
                         за той самий пакет - переставала вимагати згадувати,
                         який то був, і шукати його серед карток.
                         Кнопки «повторити» тут навмисно немає: тека виводу в
                         прогоні не зберігається, а повторна генерація переписує
                         документи - такого в один клік бути не повинно. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48"
                                Visibility="{Binding NoSelectedPackage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Оберіть пакет ліворуч або створіть новий"
                                   Foreground="{StaticResource PlaceholderBrush}"
                                   HorizontalAlignment="Center"/>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                BorderThickness="1" Padding="18" Margin="0,22,0,0" MaxWidth="420"
                                Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="ОСТАННІЙ ЗАПУСК" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding LastRunPackageName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding LastRunSummary}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Button Content="Відкрити цей пакет" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Command="{Binding OpenLastPackageCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasSelectedPackage, Converter={StaticResource BoolToVisibility}}">

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ШАБЛОНИ ПАКЕТА" Style="{StaticResource SectionTitleStyle}"/>
                            <Button Grid.Column="1" Content="⚙ Вимоги" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Вимоги пакета…" Command="{Binding OpenRequirementsCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PackageTemplates}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding KindBadge}" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Opacity="0.65"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource NavyBrush}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding XlsxDetail, StringFormat=' · {0}'}" Foreground="{StaticResource NavyBrush}"
                                                       FontSize="11" Opacity="0.75" VerticalAlignment="Center"
                                                       Visibility="{Binding IsXlsx, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ОСОБОВИЙ СКЛАД" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                BorderThickness="1" CornerRadius="0" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <RadioButton GroupName="RosterMode" Content="{Binding RecipientCount}" ContentStringFormat="Усі ({0})"
                                             IsChecked="{Binding UseAllRecipients}" Margin="0,0,0,8"/>
                                <RadioButton GroupName="RosterMode" Content="Вибрані"
                                             IsChecked="{Binding UseAllRecipients, Converter={StaticResource InverseBoolean}}"/>

                                <!-- Фільтр звань - звужує обидва варіанти вище однаково -->
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Звання" Style="{StaticResource FieldLabelStyle}"/>
                                    <ItemsControl ItemsSource="{Binding RankCategoryChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipStyle}">
                                                    <CheckBox Content="{Binding Label}" IsThreeState="True"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ToggleButton x:Name="RankListToggle" Content="Окремі звання ▾" HorizontalAlignment="Left"
                                                  Style="{StaticResource TextLinkToggleButtonStyle}" Foreground="{StaticResource AccentBrush}"
                                                  IsChecked="{Binding IsRankListExpanded}" Margin="0,4,0,0"/>

                                    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" MaxHeight="180" Margin="0,6,0,0"
                                            Visibility="{Binding IsRankListExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding RankOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Padding="8,5" Margin="4,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding UseSelectedRecipients, Converter={StaticResource BoolToVisibility}}"
                                            Margin="24,10,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding SelectedRecipientsCountLabel}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Button Content="Позначити всіх" Style="{StaticResource TextLinkButtonStyle}"
                                                Foreground="{StaticResource AccentBrush}" Command="{Binding CheckAllRecipientsCommand}"
                                                Margin="0,0,10,0"/>
                                        <Button Content="Зняти позначки" Style="{StaticResource TextLinkButtonStyle}"
                                                Foreground="{StaticResource TextSecondaryBrush}" Command="{Binding UncheckAllRecipientsCommand}"/>
                                    </StackPanel>

                                    <TextBox Tag="Пошук за ПІБ…" Margin="0,0,0,6"
                                             Text="{Binding RecipientSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" MaxHeight="220">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding RecipientOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Padding="8,6" Margin="4,2"
                                                                  Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Rank}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="12" Margin="0,0,8,0" Width="130" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FullName}" Foreground="{StaticResource TextPrimaryBrush}"
                                                                           FontSize="12.5" Width="220" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding UnitName}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBlock Text="Оберіть хоча б одну людину, щоб згенерувати документи."
                                               Foreground="{StaticResource WarnTextBrush}" FontSize="11.5" Margin="0,8,0,0"
                                               Visibility="{Binding ShowNoRecipientsSelectedHint, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="ДАТА ДОКУМЕНТА" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                    BorderThickness="1" CornerRadius="0" Padding="16">
                                <DatePicker SelectedDate="{Binding DocumentDate}" HorizontalAlignment="Left" Width="160"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ManualTagForm}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="ЗНАЧЕННЯ ДЛЯ ЦІЄЇ ГЕНЕРАЦІЇ" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                    BorderThickness="1" CornerRadius="0" Padding="16">
                                <StackPanel DataContext="{Binding ManualTagForm}">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Людський підпис; сам тег - у підказці, бо за ним
                                                         звіряються з шаблоном. Consolas прибрано: моноширинний
                                                         шрифт доречний для коду, а не для назви поля. -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               ToolTip="{Binding Tag}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <DatePicker Grid.Column="1" SelectedDate="{Binding DateValue}">
                                                        <DatePicker.Style>
                                                            <Style TargetType="DatePicker">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DatePicker.Style>
                                                    </DatePicker>
                                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Date">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Signer}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Підписант"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" DataContext="{Binding Signer}"
                                                  ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                  DisplayMemberPath="DisplayLabel"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CourseOfficer}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Курсовий офіцер"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1">
                                            <ComboBox DataContext="{Binding CourseOfficer}"
                                                      ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                      DisplayMemberPath="DisplayLabel"/>
                                            <!-- Порожній перелік означає, що жодну людину постійного складу не
                                                 позначено курсовим офіцером. Сказати це тут, а не після запуску:
                                                 інакше оператор дізнається про зупинку аж із «Запусків». -->
                                            <TextBlock Text="Немає жодного курсового офіцера - відомості з підписом не сформуються"
                                                       Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CourseOfficer.Options.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 2.1: тека підставляється сама (налаштування або Документи\GenDoc) і не
                             скидається при зміні пакета; «Змінити…» зберігає нову як типову. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Тека документів:" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding OutputFolder}" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="520" ToolTip="{Binding OutputFolder}"/>
                            <Button Content="Змінити…" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding PickOutputFolderCommand}"/>
                        </StackPanel>

                        <CheckBox Content="Генерувати повторно вже наявні" IsChecked="{Binding RegenerateExisting}" Margin="0,0,0,20"/>

                        <Button Content="{Binding GenerateButtonText}" Padding="26,12" Command="{Binding GenerateAllCommand}"
                                HorizontalAlignment="Left"
                                Visibility="{Binding NotBusy, Converter={StaticResource BoolToVisibility}}"/>

                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource SkyBrush}"
                                BorderThickness="3,0,0,0" Padding="14,10"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource NavyBrush}" FontSize="12.5"/>
                        </Border>

                        <!-- 2.4: підсумок останнього прогону - замість двох MessageBox -->
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                BorderThickness="1" Padding="14,12" Margin="0,14,0,0" DataContext="{Binding LastResult}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding SummaryText}" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0"
                                              Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2" Foreground="{StaticResource WarnTextBrush}">
                                                <Run Text="{Binding Person, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TemplateName, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Відкрити теку" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenFolderCommand}"/>
                                    <Button Content="Показати в архіві" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                            Command="{Binding ShowInArchiveCommand}" IsEnabled="{Binding CanShowInArchive}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
