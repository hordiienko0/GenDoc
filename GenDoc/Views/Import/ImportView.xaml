<UserControl x:Class="GenDoc.Views.Import.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="StepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="done">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="current">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="filled">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepConnectorStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="16,10"/>
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Імпорт з Excel" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Файл · набір і гілка · зіставлення · перевірка"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,18"/>

            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step1State}">
                        <TextBlock Text="1" Style="{StaticResource StepNumberStyle}" Tag="{Binding Step1Fill}"/>
                    </Border>
                    <TextBlock Text="Файл" Style="{StaticResource StepLabelStyle}" Tag="{Binding Step1Label}"/>
                </StackPanel>

                <Border Style="{StaticResource StepConnectorStyle}"/>

                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step2State}">
                        <TextBlock Text="2" Style="{StaticResource StepNumberStyle}" Tag="{Binding Step2Fill}"/>
                    </Border>
                    <TextBlock Text="Набір і гілка" Style="{StaticResource StepLabelStyle}" Tag="{Binding Step2Label}"/>
                </StackPanel>

                <Border Style="{StaticResource StepConnectorStyle}"/>

                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step3State}">
                        <TextBlock Text="3" Style="{StaticResource StepNumberStyle}" Tag="{Binding Step3Fill}"/>
                    </Border>
                    <TextBlock Text="Зіставлення" Style="{StaticResource StepLabelStyle}" Tag="{Binding Step3Label}"/>
                </StackPanel>

                <Border Style="{StaticResource StepConnectorStyle}"/>

                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step4State}">
                        <TextBlock Text="4" Style="{StaticResource StepNumberStyle}" Tag="{Binding Step4Fill}"/>
                    </Border>
                    <TextBlock Text="Перевірка" Style="{StaticResource StepLabelStyle}" Tag="{Binding Step4Label}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="0,14,0,0" Margin="0,14,0,0"
                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Назад" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="18,9" Command="{Binding GoBackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Grid.Column="1" Text="{Binding SkippedNoteText}" VerticalAlignment="Center"
                           Margin="16,0" FontSize="11.5" MaxWidth="420"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SkippedNoteText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding HasSkippedRows, Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Далі →" Padding="22,9" Command="{Binding GoNextCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Visibility="{Binding IsNotStep4, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{Binding ImportButtonText}" Padding="22,9"
                            Command="{Binding RunImportCommand}"
                            Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>

                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource CardStyle}" Padding="24"
                            Visibility="{Binding NoFile, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Оберіть Excel-файл (.xlsx) з особовим складом для імпорту"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Button Content="Обрати файл…" Command="{Binding PickFileCommand}"
                                    HorizontalAlignment="Center" Padding="22,9"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="24"
                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <StackPanel Margin="0,0,40,0">
                                    <TextBlock Text="ФАЙЛ" Style="{StaticResource SectionCaptionStyle}"/>
                                    <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="РЯДКІВ У ФАЙЛІ" Style="{StaticResource SectionCaptionStyle}"/>
                                    <TextBlock Text="{Binding TotalRows}" FontSize="16" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Обрати інший файл"
                                    Command="{Binding PickAnotherFileCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="20,16">
                                <RadioButton Content="Імпортувати в наявний набір" GroupName="ImportTarget"
                                             IsChecked="{Binding TargetExistingIntake, Mode=TwoWay}"
                                             VerticalAlignment="Center" Margin="0,0,28,0"/>
                                <RadioButton Content="Створити новий набір" GroupName="ImportTarget"
                                             IsChecked="{Binding TargetNewIntake, Mode=TwoWay}"
                                             VerticalAlignment="Center" Margin="0,0,28,0"/>
                                <RadioButton Content="Постійний склад (без набору)" GroupName="ImportTarget"
                                             IsChecked="{Binding TargetPermanentStaff, Mode=TwoWay}"
                                             VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0"
                                    Padding="20,16"
                                    Visibility="{Binding IsIntakeChoiceVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Набір" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Intakes}" DisplayMemberPath="Display"
                                              SelectedItem="{Binding SelectedIntake, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding NewIntakeHint}" Margin="20,0,20,16" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                       Visibility="{Binding TargetNewIntake, Converter={StaticResource BoolToVisibility}}"/>

                            <Border Background="{StaticResource RowAltBrush}" Padding="20,10"
                                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,1"
                                    Visibility="{Binding IsIntakeChoiceVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="ГІЛКА ВСЕРЕДИНІ НАБОРУ" Style="{StaticResource SectionCaptionStyle}"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Branches}"
                                          Visibility="{Binding IsIntakeChoiceVisible, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="row" Background="Transparent"
                                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                                            Padding="0,9">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource RowAltBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource AccentSoftBrush}"/>
                                                            <Setter TargetName="row" Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="{Binding Indent}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding PeopleCount}" Margin="0,0,20,0"
                                                           VerticalAlignment="Center" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Background="{StaticResource SkySoftBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="КОЛОНКА У ФАЙЛІ" Style="{StaticResource TableHeaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="ПРИКЛАД ЗНАЧЕННЯ" Style="{StaticResource TableHeaderTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="ПОЛЕ БАЗИ ДАНИХ" Style="{StaticResource TableHeaderTextStyle}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLineBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ExampleValue}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding FieldOptions}"
                                                      SelectedValuePath="Field"
                                                      SelectedValue="{Binding SelectedField, Mode=TwoWay}"
                                                      Margin="16,8" MaxWidth="240" HorizontalAlignment="Left"
                                                      MinWidth="180">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}">

                    <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,14">
                        <TextBlock Text="{Binding RowStatsText}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,14"
                            Visibility="{Binding HasMovableDuplicates, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding MoveAllDuplicates}" Content="{Binding MoveAllText}"
                                      VerticalContentAlignment="Center"/>
                            <TextBlock Text="Наявні картки будуть змінені: набір і гілка - на обрані, решта полів - лише там, де у файлі є значення. Документи, видані в попередньому наборі, лишаться на місці."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="24,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Background="{StaticResource SkySoftBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="СТАТУС" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="ПІБ" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="ЗВАННЯ" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="ПІДРОЗДІЛ" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="ПРИМІТКА" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="5" Text="ДІЯ" Style="{StaticResource TableHeaderTextStyle}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Preview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLineBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Padding="6,3"
                                                        HorizontalAlignment="Left" Margin="16,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="ОК"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                        <Setter Property="Text" Value="ПОМИЛКА"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                                        <Setter Property="Text" Value="КОНФЛІКТ"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                        <Setter Property="Text" Value="УВАГА"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding FullNameDisplay}" Margin="16,10"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RankDisplay}" Margin="16,10"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding UnitDisplay}" Margin="16,10"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="4" Text="{Binding Note}" Margin="16,10"
                                                           VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Status}" Value="Ok"/>
                                                                        <Condition Binding="{Binding Note}" Value=""/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Text" Value="-"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Grid Grid.Column="5" Margin="16,10">
                                                    <CheckBox IsChecked="{Binding Move}" Content="перенести"
                                                              VerticalAlignment="Center" FontSize="11"
                                                              Visibility="{Binding CanMove, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="-" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanMove}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
