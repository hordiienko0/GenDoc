<UserControl x:Class="GenDoc.Views.Import.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="MappingHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <TextBlock Text="Імпорт з Excel" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Завантажте Excel-файл з особовим складом і зіставте колонки перед імпортом."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5" Margin="0,4,0,22"/>

            <!-- Смуга кроків -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">

                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource SuccessBrush}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold" Foreground="{StaticResource BackgroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="Файл обрано" Style="{StaticResource StepLabelStyle}"/>
                </StackPanel>

                <Border Width="32" Height="1" Background="{StaticResource BorderLineBrush}"
                        VerticalAlignment="Center" Margin="12,0"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" CornerRadius="13">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="Зіставлення колонок" Style="{StaticResource StepLabelStyle}"/>
                </StackPanel>

                <Border Width="32" Height="1" Background="{StaticResource BorderLineBrush}"
                        VerticalAlignment="Center" Margin="12,0"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" CornerRadius="13">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="Імпорт" Style="{StaticResource StepLabelStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Стан без файлу -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="24"
                    Visibility="{Binding NoFile, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Оберіть Excel-файл (.xlsx) з особовим складом для імпорту"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="Обрати файл…" Command="{Binding PickFileCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Стан з файлом -->
            <StackPanel Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">

                <!-- Картка файлу -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="Файл" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource CardValueStyle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="Рядків у файлі" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="{Binding TotalRows}" Style="{StaticResource CardValueStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="Готово до імпорту" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="{Binding ReadyCount}" Style="{StaticResource CardValueStyle}"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasSkippedRows, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Потребують уваги" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="{Binding IssueCount}" Style="{StaticResource CardValueStyle}"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Обрати інший файл" Command="{Binding PickAnotherFileCommand}"
                                Style="{StaticResource OutlineButtonStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Зіставлення колонок -->
                <TextBlock Text="Зіставлення колонок" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="1" CornerRadius="2" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Background="{StaticResource Surface2Brush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="КОЛОНКА У ФАЙЛІ" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                            <TextBlock Grid.Column="1" Text="ПРИКЛАД ЗНАЧЕННЯ" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                            <TextBlock Grid.Column="2" Text="ПОЛЕ БАЗИ ДАНИХ" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLineBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Header}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ExampleValue}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding FieldOptions}"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Field"
                                                      SelectedValue="{Binding SelectedField, Mode=TwoWay}"
                                                      Width="220" HorizontalAlignment="Left" Margin="16,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Попередній перегляд -->
                <TextBlock Text="{Binding PreviewHeaderText}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="1" CornerRadius="2" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Background="{StaticResource Surface2Brush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="СТАТУС" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                            <TextBlock Grid.Column="1" Text="ПІБ" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                            <TextBlock Grid.Column="2" Text="ЗВАННЯ" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                            <TextBlock Grid.Column="3" Text="ПІДРОЗДІЛ" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                            <TextBlock Grid.Column="4" Text="ПРИМІТКА" Style="{StaticResource MappingHeaderTextStyle}" Margin="16,10"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Preview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLineBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="2.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="2" Padding="10,3"
                                                    HorizontalAlignment="Left" Margin="16,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" FontWeight="Bold" Text="ОК">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                    <Setter Property="Text" Value="ПОМИЛКА"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                                    <Setter Property="Text" Value="ДУБЛЬ"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Text" Value="УВАГА"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding FullNameDisplay}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RankDisplay}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UnitDisplay}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="4" Text="{Binding Note}" Margin="16,10"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="Ok"/>
                                                                    <Condition Binding="{Binding Note}" Value=""/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Text" Value="—"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Низ: кнопка імпорту -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding ImportButtonText}" Command="{Binding RunImportCommand}" Padding="26,12"/>
                    <TextBlock Text="{Binding SkippedNoteText}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13.5" VerticalAlignment="Center" Margin="16,0,0,0"
                               Visibility="{Binding HasSkippedRows, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
