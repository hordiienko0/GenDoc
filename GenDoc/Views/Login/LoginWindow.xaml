<Window x:Class="GenDoc.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:GenDoc.Converters"
        xmlns:login="clr-namespace:GenDoc.ViewModels.Login"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=login:LoginViewModel, IsDesignTimeCreatable=False}"
        Style="{StaticResource {x:Type Window}}"
        Title="Вхід - GenDoc" Height="660" Width="440"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
        <DockPanel Background="{StaticResource BackgroundBrush}">

            <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource NavyDeepBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="GenDoc - Облік особового складу" Margin="14,0,0,0"
                               FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Content="&#xE711;" Click="CloseButton_Click"
                            FontFamily="Segoe MDL2 Assets" Width="42" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="10" Cursor="Hand"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Background="{StaticResource NavyBrush}" ClipToBounds="True">
                <Image Source="{StaticResource UnitEmblemImage}" Width="620" Height="620"
                       Opacity="0.06" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,40,0,0" IsHitTestVisible="False"/>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="1" Margin="24,0,24,0"
                        VerticalAlignment="Center" Effect="{StaticResource ModalShadowEffect}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,26,24,20">
                            <Image Source="{StaticResource UnitEmblemImage}" Width="64" Height="64"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="ХНУПС ім. Івана Кожедуба" HorizontalAlignment="Center"
                                       Margin="0,14,0,0" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="GenDoc - облік особового складу" HorizontalAlignment="Center"
                                       Margin="0,4,0,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderLineBrush}"/>

                        <StackPanel Grid.Row="2" Margin="24,20,24,0"
                                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=DatabasePassword, FallbackValue=Visible}">
                            <TextBlock Text="Пароль бази даних" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0 0 0 6"/>
                            <PasswordBox x:Name="DatabasePasswordBox"
                                         PasswordChanged="DatabasePasswordBox_PasswordChanged"/>
                            <Button Content="Розблокувати" Command="{Binding UnlockDatabaseCommand}"
                                    Margin="0 18 0 0" Padding="0,11" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="24,20,24,0"
                                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=ProfileSelect, FallbackValue=Collapsed}">
                            <TextBlock Text="Профіль" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0 0 0 6"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Пароль профілю" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0 14 0 6"/>
                            <PasswordBox x:Name="ProfilePasswordBox"
                                         PasswordChanged="ProfilePasswordBox_PasswordChanged"/>
                            <Button Content="Увійти" Command="{Binding SelectLoginCommand}"
                                    Margin="0 18 0 0" Padding="0,11" HorizontalAlignment="Stretch"/>

                            <TextBlock Text="+ Створити профіль" Margin="0 14 0 0" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCreateProfileCommand}"/>
                                </TextBlock.InputBindings>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="24,20,24,0"
                                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=CreateProfile, FallbackValue=Collapsed}">
                            <TextBlock Text="Повне ім'я" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0 0 0 6"/>
                            <TextBox x:Name="NewProfileFullNameBox" Text="{Binding NewProfileFullName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Пароль" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0 14 0 6"/>
                            <PasswordBox x:Name="NewProfilePasswordBox"
                                         PasswordChanged="NewProfilePasswordBox_PasswordChanged"/>
                            <TextBlock Text="Підтвердження пароля" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0 14 0 6"/>
                            <PasswordBox x:Name="NewProfilePasswordConfirmBox"
                                         PasswordChanged="NewProfilePasswordConfirmBox_PasswordChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0 16 0 0">
                                <Button Content="Створити" Command="{Binding CreateProfileCommand}" Padding="16,8"/>
                                <Button Content="Скасувати" Command="{Binding CancelCreateProfileCommand}"
                                        Style="{StaticResource GhostButtonStyle}" Padding="16,8" Margin="10 0 0 0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="24,12,24,0"/>

                        <Border Grid.Row="4" Background="{StaticResource RowAltBrush}" Margin="0,22,0,0"
                                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0"
                                Padding="24,11">
                            <Grid>
                                <TextBlock HorizontalAlignment="Left" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding AppVersionText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Локальна база · офлайн-режим"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
