<Window x:Class="GenDoc.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GenDoc.Converters"
        Title="Вхід — GenDoc" Height="420" Width="420"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
    </Window.Resources>

    <Grid Margin="24" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Автоматизована система обліку особового складу"
                   FontSize="15" FontWeight="SemiBold" Margin="0 0 0 20" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1"
                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=DatabasePassword}">
            <TextBlock Text="Пароль бази даних" Margin="0 0 0 6"/>
            <PasswordBox x:Name="DatabasePasswordBox" PasswordChanged="DatabasePasswordBox_PasswordChanged" Padding="6"/>
            <Button Content="Розблокувати" Command="{Binding UnlockDatabaseCommand}" Margin="0 16 0 0" Padding="6" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=ProfileSelect}">
            <TextBlock Text="Профіль" Margin="0 0 0 6"/>
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                      DisplayMemberPath="FullName" Padding="6"/>
            <TextBlock Text="Пароль профілю" Margin="0 14 0 6"/>
            <PasswordBox x:Name="ProfilePasswordBox" PasswordChanged="ProfilePasswordBox_PasswordChanged" Padding="6"/>
            <Button Content="Увійти" Command="{Binding SelectLoginCommand}" Margin="0 16 0 0" Padding="6" HorizontalAlignment="Left"/>
            <Button Content="+ Новий профіль" Command="{Binding ShowCreateProfileCommand}" Margin="0 8 0 0" Padding="6" HorizontalAlignment="Left" BorderThickness="0" Background="Transparent"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=CreateProfile}">
            <TextBlock Text="Ім'я нового профілю" Margin="0 0 0 6"/>
            <TextBox Text="{Binding NewProfileFullName, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            <TextBlock Text="Пароль" Margin="0 14 0 6"/>
            <PasswordBox x:Name="NewProfilePasswordBox" PasswordChanged="NewProfilePasswordBox_PasswordChanged" Padding="6"/>
            <TextBlock Text="Повторіть пароль" Margin="0 14 0 6"/>
            <PasswordBox x:Name="NewProfilePasswordConfirmBox" PasswordChanged="NewProfilePasswordConfirmBox_PasswordChanged" Padding="6"/>
            <StackPanel Orientation="Horizontal" Margin="0 16 0 0">
                <Button Content="Створити профіль" Command="{Binding CreateProfileCommand}" Padding="6"/>
                <Button Content="Скасувати" Command="{Binding CancelCreateProfileCommand}" Padding="6" Margin="10 0 0 0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0 12 0 0"/>
    </Grid>
</Window>