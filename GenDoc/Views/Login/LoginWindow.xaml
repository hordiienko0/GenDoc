<Window x:Class="GenDoc.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:GenDoc.Converters"
        xmlns:login="clr-namespace:GenDoc.ViewModels.Login"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=login:LoginViewModel, IsDesignTimeCreatable=False}"
        Title="Вхід — GenDoc" Height="560" Width="420"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
        <DockPanel Background="{StaticResource BackgroundBrush}">

            <!-- Власна заголовна смуга замість системної рамки вікна -->
            <Border DockPanel.Dock="Top" Height="32" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Width="7" Height="7" Background="{StaticResource AccentBrush}"/>
                        <TextBlock Text="GenDoc — Облік особового складу" Margin="8,0,0,0"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click"
                            Width="46" Height="32" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="12" Cursor="Hand"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Background="{StaticResource BackgroundBrush}">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="1" CornerRadius="2" Margin="24,0,24,0" Padding="24"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Автоматизована система обліку особового складу"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0 0 0 20" TextWrapping="Wrap"/>

                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=DatabasePassword, FallbackValue=Visible}">
                            <TextBlock Text="Пароль бази даних" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0 0 0 6"/>
                            <PasswordBox x:Name="DatabasePasswordBox" Background="{StaticResource Surface2Brush}"
                                         PasswordChanged="DatabasePasswordBox_PasswordChanged"/>
                            <Button Content="Розблокувати" Command="{Binding UnlockDatabaseCommand}"
                                    Margin="0 16 0 0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=ProfileSelect, FallbackValue=Collapsed}">
                            <TextBlock Text="Профіль" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0 0 0 6"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="FullName" Background="{StaticResource Surface2Brush}"/>
                            <TextBlock Text="Пароль профілю" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0 14 0 6"/>
                            <PasswordBox x:Name="ProfilePasswordBox" Background="{StaticResource Surface2Brush}"
                                         PasswordChanged="ProfilePasswordBox_PasswordChanged"/>
                            <Button Content="Увійти" Command="{Binding SelectLoginCommand}" Margin="0 16 0 0" HorizontalAlignment="Left"/>

                            <TextBlock Text="+ Створити профіль" Margin="0 14 0 0" FontSize="13" Cursor="Hand"
                                       Foreground="{StaticResource AccentBrush}">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCreateProfileCommand}"/>
                                </TextBlock.InputBindings>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding Stage, Converter={StaticResource EnumToVisibility}, ConverterParameter=CreateProfile, FallbackValue=Collapsed}">
                            <TextBlock Text="Повне ім'я" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0 0 0 6"/>
                            <TextBox Text="{Binding NewProfileFullName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource Surface2Brush}" Height="35"/>
                            <TextBlock Text="Пароль" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0 14 0 6"/>
                            <PasswordBox x:Name="NewProfilePasswordBox" Background="{StaticResource Surface2Brush}"
                                         PasswordChanged="NewProfilePasswordBox_PasswordChanged" Height="34"/>
                            <TextBlock Text="Підтвердження пароля" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0 14 0 6"/>
                            <PasswordBox x:Name="NewProfilePasswordConfirmBox" Background="{StaticResource Surface2Brush}"
                                         PasswordChanged="NewProfilePasswordConfirmBox_PasswordChanged" Height="34"/>
                            <StackPanel Orientation="Horizontal" Margin="0 16 0 0">
                                <Button Content="Створити" Command="{Binding CreateProfileCommand}" Padding="16,8"/>
                                <Button Content="Скасувати" Command="{Binding CancelCreateProfileCommand}"
                                        Padding="16,8" Margin="10 0 0 0"
                                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0 12 0 0"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
