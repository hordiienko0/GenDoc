<Window x:Class="GenDoc.Views.Personnel.IntakeWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Новий набір" Width="480" SizeToContent="Height"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Номер набору *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding DisplayNumber, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Папка-основа *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
        <ComboBox ItemsSource="{Binding BaseNodes}" SelectedItem="{Binding SelectedBaseNode}"
                  DisplayMemberPath="DisplayName" FontFamily="Consolas"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Початок *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding DateStart}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Завершення *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding DateEnd}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Структура підпапок" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,6"/>
        <ItemsControl ItemsSource="{Binding Subfolders}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0"/>

        <TextBlock Text="{Binding ErrorText}" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"/>
            <Button Content="Створити набір" Margin="8,0,0,0" Command="{Binding CreateCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
