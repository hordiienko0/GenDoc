<Window x:Class="GenDoc.Views.Personnel.NodeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="{Binding Title}" Width="440" SizeToContent="Height"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Назва *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Назва для документів" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
        <TextBox Text="{Binding DocumentName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Як підставляється в {{підрозділ}}; якщо порожньо — використовується назва"
                   FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"/>
            <Button Content="OK" Margin="8,0,0,0" MinWidth="90" Command="{Binding OkCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
