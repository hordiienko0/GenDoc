<Window x:Class="GenDoc.Views.Personnel.PersonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GenDoc.ViewModels.Personnel"
        Style="{StaticResource {x:Type Window}}"
        Title="{Binding WindowTitle}" Width="980" Height="760"
        MinWidth="600" MinHeight="440"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- Ширину поля рахує вікно (FieldWidth): залежно від ширини поля стають в 1, 2 чи 3 колонки. -->
        <Style x:Key="FieldBlockStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="{Binding FieldWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Margin" Value="0,0,16,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Шаблон TextBox у темі застосовує Padding двічі (рамка і вміст), тож 6,4 дає ~14 px зліва й висоту 36. -->
        <Style x:Key="FieldBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="9,7,24,7"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ZoomButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <!-- Масштаб (Ctrl + коліщатко, Ctrl +/-/0) - LayoutTransform на весь вміст вікна. -->
    <DockPanel x:Name="ZoomRoot">
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="0,0,0,1" Padding="24,16,24,14">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding PersonLine}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PersonLine}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Підрозділ:"/>
                    <Run Text="{Binding UnitDisplay, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding ShortcutsHint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Border Background="{StaticResource SuccessSoftBrush}" Padding="10,6" Margin="0,10,0,0"
                        HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AddedNote}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding AddedNote}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource SuccessBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="Масштаб вікна: Ctrl + коліщатко миші, Ctrl + «+» / «-», Ctrl + 0 - як було">
                    <Button Content="−" Style="{StaticResource ZoomButtonStyle}" Click="ZoomOut_Click"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="46" TextAlignment="Center" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                               Cursor="Hand" MouseLeftButtonUp="ZoomReset_Click"/>
                    <Button Content="+" Style="{StaticResource ZoomButtonStyle}" Click="ZoomIn_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="12.5" Padding="16,8" Command="{Binding CancelCommand}"/>
                    <Button Content="Зберегти й додати ще" Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="12.5" Padding="16,8" Margin="8,0,0,0" Command="{Binding SaveAndNextCommand}"
                            Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Зберегти цю особу й одразу відкрити чисту форму для наступної"/>
                    <Button Content="Зберегти" FontSize="12.5" Padding="22,8" Margin="8,0,0,0" MinWidth="110"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" SizeChanged="BodyScroll_SizeChanged">
            <StackPanel x:Name="Body" Margin="24,16,24,10" DataContext="{Binding Card}">
                <TextBlock Text="ОСНОВНІ ДАНІ" Style="{StaticResource SectionCaptionStyle}"/>
                <Border Height="1" Background="{StaticResource BorderLineBrush}" Margin="0,5,0,12"/>

                <!-- Margin -16 праворуч: у кожного поля відступ 16 праворуч, щоб останнє в рядку не переносилось. -->
                <WrapPanel Margin="0,0,-16,0">
                    <StackPanel Style="{StaticResource FieldBlockStyle}">
                        <TextBlock Text="Прізвище *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="LastNameBox" Style="{StaticResource FieldBoxStyle}"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding LastNameError}" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldBlockStyle}">
                        <TextBlock Text="Ім'я та по батькові" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}"
                                 Text="{Binding FirstMiddle, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldBlockStyle}">
                        <TextBlock Text="Звання" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}"
                                 Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldBlockStyle}">
                        <TextBlock Text="Посада" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}"
                                 Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldBlockStyle}">
                        <TextBlock Text="Особовий номер" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}"
                                 Text="{Binding ServiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding ServiceNumberError}" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldBlockStyle}">
                        <TextBlock Text="Придатність" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Style="{StaticResource FieldComboStyle}"
                                  ItemsSource="{Binding FitnessList}" SelectedItem="{Binding Fitness}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldBlockStyle}">
                        <TextBlock Text="Кімната (корпус / №)" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FieldBoxStyle}" Tag="корпус"
                                     Text="{Binding RoomBuilding, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Style="{StaticResource FieldBoxStyle}" Tag="№"
                                     Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Text="{Binding RoomError}" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="АНКЕТНІ ДАНІ" Style="{StaticResource SectionCaptionStyle}" Margin="0,14,0,0"/>
                <Border Height="1" Background="{StaticResource BorderLineBrush}" Margin="0,5,0,12"/>

                <ItemsControl ItemsSource="{Binding QuestionnaireFields}" Focusable="False" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuestionnaireFieldViewModel}">
                            <StackPanel Style="{StaticResource FieldBlockStyle}"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Hint}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBoxStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                                    <Setter Property="AcceptsReturn" Value="True"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="MinHeight" Value="64"/>
                                                    <Setter Property="MaxHeight" Value="160"/>
                                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorTextStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
