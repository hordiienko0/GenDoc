<UserControl x:Class="GenDoc.Views.Personnel.PersonnelView"
             x:Name="PersonnelRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GenDoc.ViewModels.Personnel"
             Loaded="PersonnelView_Loaded">

    <UserControl.Resources>
        <Style x:Key="TreeFilterTabStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTabStyle" TargetType="Button" BasedOn="{StaticResource TreeFilterTabStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>

        <Style x:Key="OrgTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Visibility" Value="{Binding IsVisibleInFilter, Converter={StaticResource BoolToVisibility}}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Tag" Value="{Binding DataContext.Tree, ElementName=PersonnelRoot}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource AppContextMenuStyle}">
                        <MenuItem Header="Додати вкладену"
                                  Style="{StaticResource AppContextMenuItemStyle}"
                                  IsEnabled="{Binding CanAddChild}"
                                  Command="{Binding PlacementTarget.Tag.AddChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Перейменувати"
                                  Style="{StaticResource AppContextMenuItemStyle}"
                                  IsEnabled="{Binding CanRename}"
                                  Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Перемістити до…"
                                  Style="{StaticResource AppContextMenuItemStyle}"
                                  IsEnabled="{Binding CanMove}"
                                  Command="{Binding PlacementTarget.Tag.MoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Видалити"
                                  Style="{StaticResource AppContextMenuItemStyle}"
                                  Foreground="{StaticResource DangerBrush}"
                                  IsEnabled="{Binding CanDelete}"
                                  Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="HeaderBorder" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SelBar" Grid.Column="0" Background="Transparent"/>
                                    <ToggleButton x:Name="Expander" Grid.Column="1" Focusable="False" Cursor="Hand"
                                                  Width="16" Background="Transparent" BorderThickness="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="2,0">
                                                    <TextBlock x:Name="Glyph" Text="▸" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Glyph" Property="Text" Value="▾"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="2" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="HeaderBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="SelBar" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:OrgNodeViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="10" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IntakeStatus}" Value="Active">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                           VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActiveIntakeBranch}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompletedBranch}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="Opacity" Value="0.65"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ПАНЕЛЬ ДЕРЕВА -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}"
                            BorderThickness="0,0,0,1" Padding="12,10">
                        <TextBlock Text="СТРУКТУРА ПІДРОЗДІЛІВ" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="10,8">
                        <UniformGrid Columns="3">
                            <Button Content="Активні" Command="{Binding Tree.SetFilterCommand}" CommandParameter="Active">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TreeFilterTabStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tree.IsFilterActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Усі" Command="{Binding Tree.SetFilterCommand}" CommandParameter="All">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TreeFilterTabStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tree.IsFilterAll}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Архівні" Command="{Binding Tree.SetFilterCommand}" CommandParameter="Archived">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TreeFilterTabStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tree.IsFilterArchived}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderLineBrush}"
                            BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel>
                            <CheckBox Content="Показувати підпорядковані" FontSize="11.5"
                                      IsChecked="{Binding Tree.ShowDescendants, Mode=TwoWay}"/>
                            <Button Content="+ Новий набір" Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding Tree.NewIntakeCommand}"/>
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="OrgTree" ItemsSource="{Binding Tree.RootNodes}"
                              Background="Transparent" BorderThickness="0" Padding="4"
                              VirtualizingStackPanel.IsVirtualizing="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource OrgTreeItemStyle}"
                              PreviewMouseRightButtonDown="OrgTree_PreviewMouseRightButtonDown"/>
                </DockPanel>
            </Border>

            <!-- СПИСОК -->
            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Особовий склад" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="280" Tag="Пошук за ПІБ або посадою…"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="+ Додати" Command="{Binding AddCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Breadcrumb}"
                              ToolTip="{Binding FullPathToolTip}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" › " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="{Binding Text}" Style="{StaticResource TextLinkButtonStyle}"
                                        FontSize="12" IsEnabled="{Binding IsLink}"
                                        Command="{Binding DataContext.BreadcrumbClickCommand, ElementName=PersonnelRoot}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource SkyBrush}" BorderThickness="3,0,0,0"
                        Padding="12,7" Margin="0,0,0,8"
                        Visibility="{Binding HasChecked, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectionInfoText}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Перемістити до…" Margin="16,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding MoveCheckedCommand}"/>
                        <Button Content="Видалити" Margin="8,0,0,0"
                                Background="{StaticResource DangerBrush}" Foreground="White"
                                Command="{Binding DeleteCheckedCommand}"/>
                        <Button Content="Зняти вибір" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearCheckedCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                    <Grid>
                        <DataGrid x:Name="PeopleGrid" ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  CanUserSortColumns="False"
                                  MouseLeftButtonUp="PeopleGrid_MouseLeftButtonUp"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" CanUserResize="False"
                                                         CellStyle="{StaticResource CheckboxCellStyle}"
                                                         HeaderStyle="{StaticResource CheckboxHeaderStyle}">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox IsThreeState="True" HorizontalAlignment="Center"
                                                      IsChecked="{Binding DataContext.HeaderChecked, ElementName=PersonnelRoot, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="ПІБ" Binding="{Binding ShortName}" Width="1.8*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding ShortName}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="ЗВАННЯ" Binding="{Binding Rank}" Width="1.2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="ПОСАДА" Binding="{Binding Position}" Width="1.6*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Position}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="ПРИДАТНІСТЬ" Binding="{Binding FitnessDisplay}" Width="1.1*"/>

                                <DataGridTextColumn Header="КІМНАТА" Binding="{Binding RoomDisplay}" Width="0.8*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4" Text="{Binding FooterText}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            </Grid>
        </Grid>

        <!-- ВИСУВНА КАРТКА (overlay поверх списку) -->
        <Border HorizontalAlignment="Right" Width="380"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsCardOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid DataContext="{Binding Card}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderName}" FontWeight="Bold" FontSize="14.5"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding HeaderSub}" FontSize="11.5" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseCardCommand, ElementName=PersonnelRoot}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="16,10,16,0">
                    <UniformGrid Columns="2">
                        <Button Content="Дані" Command="{Binding SetTabCommand}" CommandParameter="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CardTabStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDataTab}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Документи" Command="{Binding SetTabCommand}" CommandParameter="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CardTabStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDocumentsTab}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,10">
                    <Grid>
                        <StackPanel Visibility="{Binding IsDataTab, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Прізвище *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding LastNameError}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastNameError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Ім'я та по батькові" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding FirstMiddle, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Звання" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Посада" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Підрозділ" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding UnitDisplay}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Зміна підрозділу — через «Перемістити до…» у списку"
                                       FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>

                            <TextBlock Text="Особовий номер" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding ServiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding ServiceNumberError}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceNumberError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Кімната (корпус / №)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding RoomBuilding, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="Придатність" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding FitnessList}" SelectedItem="{Binding Fitness}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDocumentsTab, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Documents}"
                                          Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TemplateName}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <Run Text="{Binding GeneratedAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Author, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Документи людини з'являться після реалізації архіву документів"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDocuments}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="Зберегти" Margin="8,0,0,0"
                                Command="{Binding SaveClickCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
