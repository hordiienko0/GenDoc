<Window x:Class="GenDoc.Views.Recipients.RecipientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="440" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Прізвище" Margin="0,0,0,4"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Ім'я" Margin="0,12,0,4"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="По батькові" Margin="0,12,0,4"/>
                <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Звання" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Посада" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Підрозділ" Margin="0,12,0,4"/>
                <ComboBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding UnitNameOptions}" IsEditable="True"/>

                <TextBlock Text="Особовий номер" Margin="0,12,0,4"/>
                <TextBox Text="{Binding ServiceNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Дата народження" Margin="0,12,0,4"/>
                <DatePicker SelectedDate="{Binding DateOfBirth}"/>

                <TextBlock Text="Будівля" Margin="0,12,0,4"/>
                <ComboBox Text="{Binding RoomBuilding, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding RoomBuildingOptions}" IsEditable="True"/>

                <TextBlock Text="Номер кімнати" Margin="0,12,0,4"/>
                <TextBox Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Зберегти" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Скасувати" Command="{Binding CancelCommand}" IsCancel="True"
                    Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                    Margin="8,0,0,0"/>
            <Button Content="Видалити" Command="{Binding DeleteCommand}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                    Background="Transparent" Foreground="{StaticResource DangerBrush}"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
