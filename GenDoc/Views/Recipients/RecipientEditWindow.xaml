<Window x:Class="GenDoc.Views.Recipients.RecipientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="580" Height="800"
        Background="{StaticResource ModalSurfaceBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="ServiceNumberFieldStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasServiceNumberWarning}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ModalWarnBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="FieldDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ModalLabelBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ModalLabelBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="WarningTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource ModalWarnBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{StaticResource ModalDividerBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Style="{StaticResource ModalCloseButtonStyle}" Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>

        <!-- Прогрес заповнення -->
        <StackPanel Grid.Row="1" Margin="22,14,22,0">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="Заповнено обов'язкових полів" FontSize="11.5" Foreground="{StaticResource ModalLabelBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding RequiredFieldsLabel}" FontSize="11.5" FontWeight="Bold"
                           Foreground="{StaticResource ModalAccentBrush}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Height="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RequiredFieldsFraction, Converter={StaticResource FractionToGridLength}}"/>
                    <ColumnDefinition Width="{Binding RequiredFieldsRemainingFraction, Converter={StaticResource FractionToGridLength}}"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{StaticResource Surface2Brush}" CornerRadius="2"/>
                <Border Grid.Column="0" Background="{StaticResource ModalAccentBrush}" CornerRadius="2"/>
            </Grid>
        </StackPanel>

        <!-- Поля форми -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,18,22,0">
            <StackPanel>

                <TextBlock Text="ОСОБИСТІ ДАНІ" Style="{StaticResource SectionLabelStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Прізвище *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ім'я *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="По батькові" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Width="200" HorizontalAlignment="Left" Margin="0,0,0,4">
                    <TextBlock Text="Дата народження *" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DateOfBirth}" Style="{StaticResource FieldDatePickerStyle}"/>
                </StackPanel>

                <Border Height="1" Background="{StaticResource ModalDividerBrush}" Margin="0,18"/>

                <TextBlock Text="СЛУЖБА" Style="{StaticResource SectionLabelStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Звання *" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RankOptions}"
                                  IsEditable="True" Style="{StaticResource FieldComboBoxStyle}"/>
                        <ItemsControl ItemsSource="{Binding RankSuggestions}" Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Style="{StaticResource SuggestionChipStyle}"
                                            Command="{Binding DataContext.SelectRankSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Посада *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Підрозділ *" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding UnitNameOptions}"
                              IsEditable="True" Style="{StaticResource FieldComboBoxStyle}"/>
                </StackPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Особовий номер *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding ServiceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ServiceNumberFieldStyle}"/>
                        <TextBlock Text="{Binding ServiceNumberWarningMessage}" Style="{StaticResource WarningTextStyle}"
                                   Visibility="{Binding HasServiceNumberWarning, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Корпус" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Text="{Binding RoomBuilding, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RoomBuildingOptions}"
                                  IsEditable="True" Style="{StaticResource FieldComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Кімната" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding RoomWarningMessage}" Style="{StaticResource WarningTextStyle}"
                           Visibility="{Binding HasRoomWarning, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,18"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Дії -->
        <Border Grid.Row="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource ModalDividerBrush}"
                BorderThickness="0,1,0,0" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Зберегти" Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button Content="Зберегти і додати ще" Command="{Binding SaveAndAddAnotherCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Скасувати" Command="{Binding CancelCommand}" IsCancel="True"
                        Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
