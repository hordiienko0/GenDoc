<Window x:Class="GenDoc.Views.Recipients.RecipientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="{Binding Title}" Width="580" Height="800"
        Background="{StaticResource PanelBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ServiceNumberFieldStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasServiceNumberWarning}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"/>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="WarningTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <!-- Мінімальний Expander: системний рендериться неоднорідно з нашою темою -->
        <Style TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8 Z" Fill="{StaticResource TextSecondaryBrush}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                                                  TextBlock.Foreground="{StaticResource TextSecondaryBrush}"
                                                                  TextBlock.FontSize="13" TextBlock.FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M0,0 L8,0 L4,4 Z"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuestionnaireRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Style="{StaticResource CloseButtonStyle}" Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>

        <!-- Прогрес заповнення -->
        <StackPanel Grid.Row="1" Margin="22,14,22,0">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="Заповнено обов'язкових полів" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding RequiredFieldsLabel}" FontSize="11.5" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Height="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RequiredFieldsFraction, Converter={StaticResource FractionToGridLength}}"/>
                    <ColumnDefinition Width="{Binding RequiredFieldsRemainingFraction, Converter={StaticResource FractionToGridLength}}"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{StaticResource BorderLineBrush}"/>
                <Border Grid.Column="0" Background="{StaticResource AccentBrush}"/>
            </Grid>
        </StackPanel>

        <!-- Поля форми -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,18,22,0">
            <StackPanel>

                <TextBlock Text="ОСОБИСТІ ДАНІ" Style="{StaticResource SectionLabelStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Прізвище *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" Height="63"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ім'я *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" Height="63"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="По батькові" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" Height="71"/>
                    </StackPanel>
                </Grid>

                <StackPanel Width="200" HorizontalAlignment="Left" Margin="0,0,0,4">
                    <TextBlock Text="Дата народження *" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DateOfBirth}" Style="{StaticResource FieldDatePickerStyle}"/>
                </StackPanel>

                <Border Height="1" Background="{StaticResource BorderLineBrush}" Margin="0,18"/>

                <TextBlock Text="СЛУЖБА" Style="{StaticResource SectionLabelStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Звання *" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RankOptions}"
                                  IsEditable="True" Style="{StaticResource FieldComboBoxStyle}"/>
                        <ItemsControl ItemsSource="{Binding RankSuggestions}" Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Style="{StaticResource SuggestionChipStyle}"
                                            Command="{Binding DataContext.SelectRankSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Посада *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" Height="61"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Підрозділ *" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding UnitNameOptions}"
                              IsEditable="True" Style="{StaticResource FieldComboBoxStyle}" Height="43"/>
                </StackPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Особовий номер *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding ServiceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ServiceNumberFieldStyle}" Height="68"/>
                        <TextBlock Text="{Binding ServiceNumberWarningMessage}" Style="{StaticResource WarningTextStyle}"
                                   Visibility="{Binding HasServiceNumberWarning, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Корпус" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Text="{Binding RoomBuilding, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RoomBuildingOptions}"
                                  IsEditable="True" Style="{StaticResource FieldComboBoxStyle}" Height="43"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Кімната" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" Height="62"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding RoomWarningMessage}" Style="{StaticResource WarningTextStyle}"
                           Visibility="{Binding HasRoomWarning, Converter={StaticResource BoolToVisibility}}"/>

                <Border Height="1" Background="{StaticResource BorderLineBrush}" Margin="0,18"/>

                <Expander Header="Анкетні дані (прикомандировані)" IsExpanded="False">
                    <StackPanel Margin="0,14,0,0">

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Національність" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Nationality, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ВОС на який навчається" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Vos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="З якого часу прибув на курси П та ПК" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding CourseArrivalDate}" Style="{StaticResource FieldDatePickerStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Сімейний стан (контакт близької людини)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding MaritalStatus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Адреса реєстрації" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding RegistrationAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Адреса фактичного проживання" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding ResidenceAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Телефон" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Примітка" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Група" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ПІБ на іноземній мові" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NameTransliterated, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Служив/не служив" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding ServedBefore, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Примітка (2)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding ExtraNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Безпосередній командир (ПІП та номер телефону)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CommanderContact, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="№ посвідчення про відрядження" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding TravelCertificateNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Дата посвідчення про відрядження" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding TravelCertificateDate}" Style="{StaticResource FieldDatePickerStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Прод атестат" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding FoodCertificate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <StackPanel>
                                <TextBlock Text="Номер посвідчення офіцера/військового квитка" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding IdDocumentNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ВЛК, №, дата" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding MedicalBoardNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldTextBoxStyle}" Tag="№"/>
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding MedicalBoardDate}"
                                                Style="{StaticResource FieldDatePickerStyle}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Висновок ВЛК" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding MedicalBoardConclusion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="З якої військової частини прибув" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding OriginUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Автомобіль, номер авто" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Vehicle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Expander>

                <Expander Header="Уточнення відмінків" IsExpanded="False" Margin="0,10,0,0">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Використовуються для {{звання_зв}}, {{піб_зв}}, {{прибув}}, {{таким}} у шаблонах. Якщо поле порожнє — форма обчислюється автоматично."
                                   Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <StackPanel>
                                <TextBlock Text="Стать" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Чоловіча" IsChecked="{Binding IsGenderMale}" Margin="0,4,20,0"/>
                                    <RadioButton Content="Жіноча" IsChecked="{Binding IsGenderFemale}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource QuestionnaireRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Звання (знахідний відмінок)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding RankAccusative, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ПІБ (знахідний відмінок)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding FullNameAccusative, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,18"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Дії -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="0,1,0,0" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Зберегти" Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button Content="Зберегти і додати ще" Command="{Binding SaveAndAddAnotherCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Скасувати" Command="{Binding CancelCommand}" IsCancel="True"
                        Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
