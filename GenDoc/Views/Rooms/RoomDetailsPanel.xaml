<UserControl x:Class="GenDoc.Views.Rooms.RoomDetailsPanel"
             x:Name="DetailsPanelRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PanelCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnassignedPersonRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка панелі -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SelectedRoomTitle}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRoomTitle}"/>
            <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource PanelCloseButtonStyle}" Command="{Binding CloseRoomCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding SelectedRoomOccupancyLabel}" FontSize="13.5" Margin="0,4,0,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedRoom.IsOverCapacity}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedRoom.IsEmpty}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Смуга заповненості -->
        <Grid Grid.Row="2" Height="4" Margin="0,0,0,18">
            <Border x:Name="OccupancyBarTrack" Background="{StaticResource Surface2Brush}" CornerRadius="2"/>
            <Rectangle HorizontalAlignment="Left" RadiusX="2" RadiusY="2">
                <Rectangle.Width>
                    <MultiBinding Converter="{StaticResource OccupancyToWidth}">
                        <Binding Path="SelectedRoom.OccupantCount"/>
                        <Binding Path="SelectedRoom.Capacity"/>
                        <Binding ElementName="OccupancyBarTrack" Path="ActualWidth"/>
                    </MultiBinding>
                </Rectangle.Width>
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedRoom.IsOverCapacity}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </Grid>

        <!-- Таблиця мешканців -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" CornerRadius="2"
                Background="{StaticResource SurfaceBrush}" ClipToBounds="True" Margin="0,0,0,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="2.4*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="№" Padding="14,11" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="ПІБ" Padding="14,11" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="ЗВАННЯ" Padding="14,11" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="Завантаження…" Foreground="{StaticResource TextSecondaryBrush}"
                           Padding="40" HorizontalAlignment="Center"
                           Visibility="{Binding IsOccupantsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock DockPanel.Dock="Top" Text="У кімнаті нікого немає" Foreground="{StaticResource TextSecondaryBrush}"
                           Padding="40" HorizontalAlignment="Center"
                           Visibility="{Binding ShowOccupantsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowOccupantsList, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Occupants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="OccupantRowGrid" Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="2.4*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0"/>

                                    <TextBlock Grid.Column="0" Text="{Binding RowNumber}" Padding="14,11" VerticalAlignment="Center"
                                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"/>

                                    <StackPanel Grid.Column="1" Margin="14,11" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontSize="13.5" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}"/>
                                        <TextBlock Text="{Binding PositionUnitDisplay}" FontSize="12.5" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PositionUnitDisplay}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Rank}" Padding="14,11" VerticalAlignment="Center"
                                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=OccupantRowGrid}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Column="2" Content="Виселити" Foreground="{StaticResource DangerBrush}"
                                            FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                            Command="{Binding DataContext.UnassignPersonCommand, ElementName=DetailsPanelRoot}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TextLinkButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=OccupantRowGrid}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Поселення -->
        <StackPanel Grid.Row="4">
            <Button Content="+ Поселити" Padding="18,9" FontWeight="SemiBold" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ShowAssignCommand}"
                    Visibility="{Binding IsNotAssigning, Converter={StaticResource BoolToVisibility}}"/>

            <StackPanel Visibility="{Binding IsAssigning, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,0,0,8">
                    <TextBox x:Name="AssignSearchBox" Text="{Binding AssignSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,9"/>
                    <TextBlock Text="Пошук за ПІБ або особовим номером…" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsAssignSearchEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding AssignResults}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource UnassignedPersonRowStyle}"
                                    Command="{Binding DataContext.AssignPersonCommand, ElementName=DetailsPanelRoot}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding FullName}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Rank}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text=" · " FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Unit}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Скасувати" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Left" Padding="0" BorderThickness="0"
                        Command="{Binding CancelAssignCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
