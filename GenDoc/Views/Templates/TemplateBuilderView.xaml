<UserControl x:Class="GenDoc.Views.Templates.TemplateBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GenDoc.Views.Templates"
             xmlns:builderVm="clr-namespace:GenDoc.ViewModels.Templates.Builder">

    <UserControl.Resources>
        <Style x:Key="PanelCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PaletteFieldStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="ToolTip" Value="Вставити в позицію курсора"/>
        </Style>

        <Style x:Key="ModeTabStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="20,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BlockActionStyle" TargetType="Button" BasedOn="{StaticResource RowIconButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>

        <DataTemplate DataType="{x:Type builderVm:PreviewLineViewModel}">
            <TextBlock local:PreviewInlines.Runs="{Binding Runs}"
                       Width="{Binding DataContext.PreviewTextWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Left"
                       TextAlignment="{Binding Style.Alignment}"
                       FontWeight="{Binding Style.Weight}"
                       FontStyle="{Binding Style.Slant}"
                       FontFamily="{Binding Style.Family}"
                       FontSize="{Binding Style.Size}"
                       Foreground="{Binding Style.Foreground}"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type builderVm:PreviewTableViewModel}">
            <Border BorderBrush="#333333" BorderThickness="1,1,0,0" HorizontalAlignment="Left"
                    Margin="0,4,0,10"
                    Width="{Binding DataContext.PreviewTextWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Headers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#333333" BorderThickness="0,0,1,1" Padding="5,4">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               FontFamily="{Binding DataContext.HeaderStyle.Family, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontSize="{Binding DataContext.HeaderStyle.Size, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontWeight="{Binding DataContext.HeaderStyle.Weight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontStyle="{Binding DataContext.HeaderStyle.Slant, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Foreground="{Binding DataContext.HeaderStyle.Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#333333" BorderThickness="0,0,1,1" Padding="5,4">
                                    <TextBlock local:PreviewInlines.Runs="{Binding}" TextWrapping="Wrap"
                                               FontFamily="{Binding DataContext.Style.Family, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontSize="{Binding DataContext.Style.Size, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontWeight="{Binding DataContext.Style.Weight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontStyle="{Binding DataContext.Style.Slant, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Foreground="{Binding DataContext.Style.Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               TextAlignment="{Binding DataContext.Style.Alignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="StyleToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Конструктор шаблонів" FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding SubtitleText}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Документ Word" Style="{StaticResource ModeTabStyle}"
                            Command="{Binding SwitchModeCommand}" CommandParameter="Word"
                            IsEnabled="{Binding CanSwitchMode}"
                            Tag="{Binding IsWordMode}"/>
                    <Button Content="Відомість Excel" Style="{StaticResource ModeTabStyle}" Margin="1,0,0,0"
                            Command="{Binding SwitchModeCommand}" CommandParameter="Excel"
                            IsEnabled="{Binding CanSwitchMode}"
                            Tag="{Binding IsExcelMode}"/>
                </StackPanel>
            </StackPanel>

            <Button Content="← До переліку шаблонів" Style="{StaticResource TextLinkButtonStyle}"
                    Foreground="{StaticResource AccentBrush}" FontSize="12"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding CloseCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="{Binding PreviewPanelWidth}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="13,10">
                        <TextBlock Text="ДОДАТИ БЛОК" Style="{StaticResource PanelCaptionStyle}"/>
                    </Border>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding BlockPalette}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left"
                                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLineBrush}"
                                        Padding="13,9" FontSize="12.5"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Command="{Binding DataContext.AddBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Width="20" TextAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Label}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="13,10">
                        <TextBlock Text="ПОЛЯ" Style="{StaticResource PanelCaptionStyle}"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FieldGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                                   Margin="13,9,13,5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceType}" Value="Manual">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Fields}" Margin="10,0,10,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Tag}" Tag="{Binding Tag}"
                                                            Style="{StaticResource PaletteFieldStyle}"
                                                            Click="PaletteField_Click"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="12,0,12,0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="13,10">
                        <TextBlock Text="ДОКУМЕНТ" Style="{StaticResource PanelCaptionStyle}"/>
                    </Border>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="10,7" Background="{StaticResource RowAltBrush}"
                            Visibility="{Binding IsExcelMode, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕ аркуш" Style="{StaticResource TextLinkButtonStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"
                                    ToolTip="Видалити останній аркуш"
                                    Command="{Binding RemoveLastSheetCommand}"/>
                            <Button DockPanel.Dock="Right" Content="+ аркуш" Style="{StaticResource TextLinkButtonStyle}"
                                    Foreground="{StaticResource AccentBrush}"
                                    Command="{Binding AddSheetCommand}"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Sheets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ModeTabStyle}" Padding="12,4" FontSize="12"
                                                    Margin="0,0,1,0" Content="{Binding Name}" Tag="{Binding IsCurrent}"
                                                    Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="10,7"
                            Visibility="{Binding IsExcelMode, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Назва аркуша:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding CurrentSheetName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="напр. Відомість"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}">
                        <StackPanel Margin="12">
                            <ItemsControl ItemsSource="{Binding VisibleBlocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Background="{StaticResource PanelBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                                                        Padding="10,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource RowAltBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding HeaderTitle}" VerticalAlignment="Center"
                                                                   FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1" Text="{Binding LayoutCaption}" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" Margin="10,0,10,0" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"/>

                                                        <TextBlock Grid.Column="1" Text="{Binding CollapsedSummary}" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left" Margin="12,0,10,0" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis" FontStyle="Italic"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}"/>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <ToggleButton x:Name="StyleToggle" Width="26" Height="22" Cursor="Hand"
                                                                          ToolTip="Шрифт, розмір, колір, вирівнювання"
                                                                          IsChecked="{Binding IsStyleOpen, Mode=TwoWay}">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="chip" Background="Transparent" BorderThickness="1"
                                                                                BorderBrush="Transparent">
                                                                            <TextBlock Text="Aa" FontSize="11.5" FontWeight="Bold"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       x:Name="glyph"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                                <Setter TargetName="glyph" Property="Foreground" Value="White"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>

                                                            <Popup IsOpen="{Binding IsStyleOpen, Mode=TwoWay}" StaysOpen="False"
                                                                   PlacementTarget="{Binding ElementName=StyleToggle}"
                                                                   Placement="Bottom" HorizontalOffset="-210" AllowsTransparency="True">
                                                                <Border Background="{StaticResource PanelBrush}" Padding="12"
                                                                        BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                                                                        Width="264">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
                                                                    </Border.Effect>

                                                                    <StackPanel>
                                                                        <TextBlock Text="ОФОРМЛЕННЯ" Style="{StaticResource PanelCaptionStyle}"
                                                                                   Margin="0,0,0,9"/>

                                                                        <TextBlock Text="Шрифт" FontSize="11" Margin="0,0,0,3"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <ComboBox ItemsSource="{x:Static builderVm:BuilderBlockViewModel.FontOptions}" DisplayMemberPath="Label"
                                                                                  SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                                                                  Margin="0,0,0,9"/>

                                                                        <Grid Margin="0,0,0,9">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                                <TextBlock Text="Розмір" FontSize="11" Margin="0,0,0,3"
                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <ComboBox ItemsSource="{x:Static builderVm:BuilderBlockViewModel.FontSizeOptions}" DisplayMemberPath="Label"
                                                                                          SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}"/>
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                                                                <TextBlock Text="Накреслення" FontSize="11" Margin="0,0,0,3"
                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <ToggleButton Content="Ж" FontWeight="Bold" ToolTip="Жирний"
                                                                                                  Style="{StaticResource StyleToggleStyle}"
                                                                                                  IsChecked="{Binding IsBold, Mode=TwoWay}"/>
                                                                                    <ToggleButton Content="К" FontStyle="Italic" ToolTip="Курсив"
                                                                                                  Style="{StaticResource StyleToggleStyle}"
                                                                                                  IsChecked="{Binding IsItalic, Mode=TwoWay}"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <TextBlock Text="Вирівнювання" FontSize="11" Margin="0,0,0,3"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                                            <RadioButton Content="◧" ToolTip="Ліворуч"
                                                                                         Style="{StaticResource StyleRadioStyle}"
                                                                                         IsChecked="{Binding IsAlignLeft, Mode=TwoWay}"/>
                                                                            <RadioButton Content="◫" ToolTip="По центру"
                                                                                         Style="{StaticResource StyleRadioStyle}"
                                                                                         IsChecked="{Binding IsAlignCenter, Mode=TwoWay}"/>
                                                                            <RadioButton Content="◨" ToolTip="Праворуч"
                                                                                         Style="{StaticResource StyleRadioStyle}"
                                                                                         IsChecked="{Binding IsAlignRight, Mode=TwoWay}"/>
                                                                            <RadioButton Content="▤" ToolTip="По ширині"
                                                                                         Style="{StaticResource StyleRadioStyle}"
                                                                                         IsChecked="{Binding IsAlignJustify, Mode=TwoWay}"/>
                                                                        </StackPanel>

                                                                        <TextBlock Text="Колір" FontSize="11" Margin="0,0,0,3"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <ComboBox ItemsSource="{x:Static builderVm:BuilderBlockViewModel.ColorOptions}"
                                                                                  SelectedItem="{Binding SelectedColor, Mode=TwoWay}">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <Border Width="13" Height="13" Background="{Binding Swatch}"
                                                                                                BorderBrush="{StaticResource BorderLineBrush}"
                                                                                                BorderThickness="1" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding Label}" Margin="7,0,0,0"
                                                                                                   VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>

                                                                        <TextBlock Text="{Binding StyleScopeHint}" FontSize="10.5" TextWrapping="Wrap"
                                                                                   Margin="0,9,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                                                                   Visibility="{Binding IsStyleScopeHintVisible, Converter={StaticResource BoolToVisibility}}"/>

                                                                        <Button Content="Скинути до типового" Margin="0,10,0,0"
                                                                                Style="{StaticResource TextLinkButtonStyle}"
                                                                                HorizontalAlignment="Left"
                                                                                Foreground="{StaticResource AccentBrush}"
                                                                                Command="{Binding ResetStyleCommand}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Popup>

                                                            <Button Content="↑" Style="{StaticResource BlockActionStyle}" ToolTip="Вище"
                                                                    Command="{Binding DataContext.MoveBlockUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="↓" Style="{StaticResource BlockActionStyle}" ToolTip="Нижче"
                                                                    Command="{Binding DataContext.MoveBlockDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="✕" Style="{StaticResource BlockActionStyle}" ToolTip="Видалити блок"
                                                                    Command="{Binding DataContext.RemoveBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>

                                                            <Button Content="{Binding CollapseIcon}" Style="{StaticResource BlockActionStyle}"
                                                                    ToolTip="{Binding CollapseTooltip}" FontWeight="Bold"
                                                                    Command="{Binding ToggleCollapsedCommand}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">

                                                <TextBox Margin="13,11" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="{Binding Watermark}"
                                                         AcceptsReturn="{Binding IsMultiline}"
                                                         TextWrapping="Wrap" GotFocus="BlockText_GotFocus"
                                                         FontFamily="{Binding DisplayStyle.Family}"
                                                         FontSize="{Binding DisplayStyle.Size}"
                                                         FontWeight="{Binding DisplayStyle.Weight}"
                                                         FontStyle="{Binding DisplayStyle.Slant}"
                                                         Foreground="{Binding DisplayStyle.Foreground}"
                                                         TextAlignment="{Binding DisplayStyle.Alignment}"
                                                         Visibility="{Binding IsTextBlock, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                                                    <Setter Property="MinHeight" Value="70"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Paragraph">
                                                                    <Setter Property="MinHeight" Value="76"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <StackPanel Margin="13,11"
                                                            Visibility="{Binding IsSignatures, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl ItemsSource="{Binding Signatures}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,7">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="130"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBox Grid.Column="0" Tag="напр. Здав"
                                                                             Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                                             GotFocus="BlockText_GotFocus" Margin="0,0,8,0"/>

                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                                              DisplayMemberPath="Display"
                                                                              SelectedItem="{Binding Signatory, Mode=TwoWay}"/>

                                                                    <Button Grid.Column="2" Content="✕" ToolTip="Прибрати рядок"
                                                                            Style="{StaticResource BlockActionStyle}" Margin="6,0,0,0"
                                                                            Command="{Binding DataContext.RemoveSignatureLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="+ Рядок підпису" Style="{StaticResource TextLinkButtonStyle}"
                                                            Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.AddSignatureLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>

                                                <StackPanel Margin="13,11"
                                                            Visibility="{Binding IsTable, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1" Text="ЗАГОЛОВОК"
                                                                   Style="{StaticResource PanelCaptionStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="КЛІТИНКА" Margin="8,0,0,0"
                                                                   Style="{StaticResource PanelCaptionStyle}"/>
                                                        <TextBlock Grid.Column="3" Text="" Width="28"/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Columns}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="26"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0" Text="{Binding Letter}"
                                                                               VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                                                    <TextBox Grid.Column="1" Tag="напр. ПІБ"
                                                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                             GotFocus="BlockText_GotFocus"/>

                                                                    <TextBox Grid.Column="2" Margin="8,0,0,0" Tag="напр. {{піб}}"
                                                                             FontFamily="Consolas"
                                                                             Text="{Binding Cell, UpdateSourceTrigger=PropertyChanged}"
                                                                             GotFocus="BlockText_GotFocus"/>

                                                                    <Button Grid.Column="3" Content="✕" ToolTip="Прибрати колонку"
                                                                            Style="{StaticResource BlockActionStyle}" Margin="6,0,0,0"
                                                                            Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="+ Колонка" Style="{StaticResource TextLinkButtonStyle}"
                                                            Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                                            Margin="0,2,0,0"
                                                            Command="{Binding DataContext.AddColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>

                                                    <CheckBox Content="Повторювати рядок для кожної особи" Margin="0,8,0,0"
                                                              IsChecked="{Binding RepeatPerPerson, Mode=TwoWay}"
                                                              Visibility="{Binding IsRepeatToggleVisible, Converter={StaticResource BoolToVisibility}}"/>

                                                    <TextBlock Text="Рядок повторюється для кожної особи списку"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                               Margin="0,8,0,0"
                                                               Visibility="{Binding IsRepeatHintVisible, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource GhostButtonStyle}" Padding="16" Margin="0,0,0,10"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderLineBrush}"
                                    Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                    ToolTip="Додати абзац; інші типи блоків - у палітрі ліворуч"
                                    Command="{Binding AddBlockCommand}"
                                    CommandParameter="{Binding ParagraphPaletteItem}">
                                <TextBlock Text="+ Додати блок"/>
                            </Button>

                            <TextBlock Text="Клік по полю в лівій панелі вставить мітку в позицію курсора"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       Margin="2,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    MinWidth="260" MaxWidth="900"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                <DockPanel>

                    <Thumb DockPanel.Dock="Left" Width="6" Cursor="SizeWE"
                           DragDelta="PreviewResizeThumb_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderLineBrush}"
                                        BorderThickness="0,0,1,0"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="13,10">
                        <TextBlock Text="ПОПЕРЕДНІЙ ПЕРЕГЛЯД" Style="{StaticResource PanelCaptionStyle}"/>
                    </Border>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="13,10">
                        <DockPanel>
                            <TextBlock Text="Тестова особа:" DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,9,0"/>
                            <ComboBox ItemsSource="{Binding TestPeople}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedTestPerson, Mode=TwoWay}"/>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1"
                            Padding="13,8"
                            Visibility="{Binding IsExcelMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SheetRangeCaption}" FontSize="11.5" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="{StaticResource RowAltBrush}"
                            BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,1,0,0" Padding="13,9">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="11" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="з бази" Margin="5,0,14,0" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Width="14" Height="11" Background="{StaticResource WarningSoftBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="вручну при генерації" Margin="5,0,0,0" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="{StaticResource BackgroundBrush}"
                                  Visibility="{Binding IsWordMode, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="White" Margin="14" Padding="24,26"
                                HorizontalAlignment="Left"
                                MinWidth="{Binding PreviewPageWidth}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#2A3B5C"/>
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding PreviewItems}"/>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Background="{StaticResource BackgroundBrush}"
                                  Visibility="{Binding IsExcelMode, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="White" Margin="10" BorderBrush="{StaticResource BorderLineBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel Background="{StaticResource RowAltBrush}">
                                    <Border DockPanel.Dock="Left" Width="32" BorderBrush="{StaticResource BorderLineBrush}"
                                            BorderThickness="0,0,1,1"/>
                                    <ItemsControl ItemsSource="{Binding SheetColumnLetters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,1,1"
                                                        Padding="4,3" MinWidth="86" MaxWidth="130">
                                                    <TextBlock Text="{Binding}" TextAlignment="Center" FontSize="11"
                                                               FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding SheetRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="32" Padding="4,3"
                                                        Background="{StaticResource RowAltBrush}"
                                                        BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding Number}" TextAlignment="Center" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderLineBrush}"
                                                                    BorderThickness="0,0,1,1" Padding="5,4" MinHeight="26">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="MinWidth" Value="86"/>
                                                                        <Setter Property="MaxWidth" Value="130"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsMerged, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                                         Value="True">
                                                                                <Setter Property="MinWidth" Value="0"/>
                                                                                <Setter Property="MaxWidth" Value="Infinity"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock local:PreviewInlines.Runs="{Binding}" TextWrapping="Wrap"
                                                                           FontFamily="{Binding DataContext.Style.Family, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                           FontSize="{Binding DataContext.Style.Size, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                           Foreground="{Binding DataContext.Style.Foreground, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                           TextAlignment="{Binding DataContext.Style.Alignment, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                           FontWeight="{Binding DataContext.Style.Weight, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                           FontStyle="{Binding DataContext.Style.Slant, RelativeSource={RelativeSource AncestorType=DockPanel}}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="0,1,0,0" Padding="0,11,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="НАЗВА ШАБЛОНУ" Style="{StaticResource PanelCaptionStyle}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Grid.Column="1" MaxWidth="420" HorizontalAlignment="Left" MinWidth="180"
                         Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                         Tag="напр. Акт на зберігання зброї"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Content="Аркуш на кожну дату періоду" VerticalAlignment="Center"
                              Margin="14,0,0,0"
                              IsChecked="{Binding RepeatSheetPerDate, Mode=TwoWay}"
                              Visibility="{Binding IsExcelMode, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Margin="14,0" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}"/>
                    <Button Content="{Binding OpenExternallyButtonText}" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" Padding="14,8"
                            ToolTip="Відкрити зібраний файл у Word - правки у ньому назад у шаблон не повертаються"
                            Command="{Binding OpenExternallyCommand}"/>

                    <Button Content="{Binding ExportButtonText}" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,8" FontSize="12.5" FontWeight="SemiBold"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="Зберегти шаблон" Margin="8,0,0,0" Padding="20,8" FontSize="12.5"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
