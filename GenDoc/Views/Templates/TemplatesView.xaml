<UserControl x:Class="GenDoc.Views.Templates.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:templatesVm="clr-namespace:GenDoc.ViewModels.Templates"
             xmlns:local="clr-namespace:GenDoc.Views.Templates">

    <UserControl.Resources>
        <Style x:Key="TemplatesHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TemplatesSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Рядок Excel-шаблону. Винесено в ресурси, бо той самий рядок тепер
             малюють два списки: Excel із тегами йде до шаблонів документів,
             Excel без тегів — до шаблонів експорту списків. -->
                            <DataTemplate DataType="{x:Type templatesVm:ExportTemplateListItemViewModel}">
                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLineBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Grid, а не StackPanel: у горизонтальному StackPanel назва
                                                 отримує всю потрібну їй ширину і виштовхує бейдж за межі
                                                 колонки, тож обрізало саме бейдж. Тепер стискається назва. -->
                                            <Grid Grid.Column="0" Margin="20,13" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" Padding="6,2"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Вбудований" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" Padding="6,2"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsFromBuilder, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Конструктор" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding OriginalFileName}" Margin="20,13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UploadedAtDisplay}" Margin="20,13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TagCount}" Margin="20,13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,13">
                                                <Button Content="&#xE8A5;" Style="{StaticResource RowIconButtonStyle}"
                                                        ToolTip="Відкрити в конструкторі"
                                                        Visibility="{Binding IsFromBuilder, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.EditExportWithBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="&#xE70F;" Style="{StaticResource RowIconButtonStyle}" ToolTip="Переглянути мапінг" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="&#xE74D;" Style="{StaticResource RowIconButtonStyle}" ToolTip="Видалити" Margin="4,0,0,0"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>


        <DataTemplate x:Key="ExportMappingEditorTemplate">
                                        <StackPanel Margin="20,0,20,16">
                                            <Border Background="{StaticResource RowAltBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                                    BorderThickness="1" CornerRadius="0" Padding="16">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Тег / колонка шаблону"
                                                                   Style="{StaticResource TemplatesHeaderTextStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="Джерело"
                                                                   Style="{StaticResource TemplatesHeaderTextStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="Поле"
                                                                   Style="{StaticResource TemplatesHeaderTextStyle}"/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Mappings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="1.1*"/>
                                                                        <ColumnDefinition Width="1.4*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding UsesPlaceholders}" Value="True">
                                                                                        <Setter Property="FontFamily" Value="Consolas"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}"
                                                                              SelectedValuePath="Value"
                                                                              SelectedValue="{Binding SourceType, Mode=TwoWay}"
                                                                              Visibility="{Binding UsesPlaceholders, Converter={StaticResource BoolToVisibility}}"
                                                                              MaxWidth="180" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Display}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding FieldOptions}"
                                                                              SelectedValuePath="Field"
                                                                              SelectedValue="{Binding SelectedField, Mode=TwoWay}"
                                                                              Visibility="{Binding IsHeaderMode, Converter={StaticResource BoolToVisibility}}"
                                                                              MaxWidth="260" HorizontalAlignment="Stretch">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding RecipientOrOrgFieldOptions}"
                                                                              SelectedValuePath="FieldName"
                                                                              SelectedValue="{Binding SelectedFieldName, Mode=TwoWay}"
                                                                              IsEnabled="{Binding IsFieldEnabled}"
                                                                              Visibility="{Binding UsesPlaceholders, Converter={StaticResource BoolToVisibility}}"
                                                                              MaxWidth="260" HorizontalAlignment="Stretch">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <CheckBox Content="Повторювати аркуш на кожну дату періоду"
                                                              IsChecked="{Binding RepeatSheetPerDate, Mode=TwoWay}"
                                                              Visibility="{Binding UsesPlaceholders, Converter={StaticResource BoolToVisibility}}"
                                                              Margin="0,8,0,0"/>

                                                    <Button Content="Зберегти мапінг" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                            Command="{Binding DataContext.SaveMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DocxMappingEditorTemplate">
                                        <StackPanel Margin="20,0,20,16">
                                            <Border Background="{StaticResource RowAltBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                                    BorderThickness="1" CornerRadius="0" Padding="16">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Коротка назва (для колонок матриці):"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBox Grid.Column="1" Text="{Binding ShortNameEdit, UpdateSourceTrigger=PropertyChanged}"
                                                                 Tag="напр. Рапорт"/>
                                                        <Button Grid.Column="2" Content="Зберегти" Style="{StaticResource SecondaryButtonStyle}"
                                                                Margin="10,0,0,0"
                                                                Command="{Binding DataContext.SaveShortNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>

                                                    <!-- Для кого шаблон. Зберігається одразу, без окремої кнопки:
                                                         це один прапорець, а не текст, який ще треба доredагувати.
                                                         Шаблон постійного складу зникає зі звичайної генерації й
                                                         пакетів, і навпаки — тому підпис пояснює наслідок. -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="Для кого:" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12" Margin="0,0,10,0"/>
                                                        <CheckBox Content="Постійний склад" VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsForPermanentStaff, Mode=TwoWay}"
                                                                  ToolTip="Такий шаблон видно лише в «Постійному складі» — у генерації й пакетах його не буде"/>
                                                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding AudienceCaption, StringFormat=зараз: {0}}"/>
                                                    </StackPanel>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="150"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Мітка" Style="{StaticResource TemplatesHeaderTextStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="Джерело" Style="{StaticResource TemplatesHeaderTextStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="Поле" Style="{StaticResource TemplatesHeaderTextStyle}"/>
                                                        <TextBlock Grid.Column="3" Text="Формат дати" Style="{StaticResource TemplatesHeaderTextStyle}"/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Mappings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="1.1*"/>
                                                                        <ColumnDefinition Width="1.4*"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0" Text="{Binding PlaceholderTag}"
                                                                               FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}"
                                                                              SelectedValuePath="Value"
                                                                              SelectedValue="{Binding SourceType, Mode=TwoWay}"
                                                                              MaxWidth="180" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Display}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding FieldOptions}"
                                                                              SelectedValuePath="FieldName"
                                                                              SelectedValue="{Binding SelectedFieldName, Mode=TwoWay}"
                                                                              IsEnabled="{Binding IsFieldEnabled}"
                                                                              MaxWidth="260" HorizontalAlignment="Stretch">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding DateFormatOptions}"
                                                                              SelectedValuePath="Key"
                                                                              SelectedValue="{Binding SelectedDateFormat, Mode=TwoWay}"
                                                                              Visibility="{Binding IsDateField, Converter={StaticResource BoolToVisibility}}"
                                                                              MaxWidth="140" HorizontalAlignment="Stretch">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Display}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="Зберегти мапінг" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                            Command="{Binding DataContext.SaveDocxMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

  <Grid>
    <!-- Конструктор — повноекранний режим цього ж розділу, не окремий пункт меню. -->
    <local:TemplateBuilderView DataContext="{Binding Builder}"
                               Visibility="{Binding DataContext.IsBuilderOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}">
        <!-- Майстер-деталь за макетом: перелік шаблонів ліворуч, мапінг обраного —
             праворуч, замість розкривного блоку всередині рядка. -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <!-- MinWidth: панель мапінгу росте під вміст, але перелік шаблонів
                     не має права звузитись до трьох літер у колонці «Назва». -->
                <ColumnDefinition Width="*" MinWidth="380"/>
                <!-- Auto: поки панель мапінгу схована, колонка має нульову ширину
                     і переліки займають усе місце; коли показана — росте під вміст
                     у межах MinWidth/MaxWidth самої панелі. -->
                <ColumnDefinition Width="{Binding MappingPanelColumnWidth}"/>
            </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,18,0">

            <TextBlock Text="Шаблони" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Шаблони, з яких формуються документи, і шаблони вивантаження списків"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,4,0,22"/>

            <!-- Групування за призначенням, а не за розширенням: Excel-шаблони з
                 {{тегами}} теж формують документи (відомості, додатки), тож їм місце
                 тут, а не серед вивантажень списків. -->
            <TextBlock Text="Шаблони документів" Style="{StaticResource TemplatesSectionTitleStyle}"/>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1" CornerRadius="0" Margin="0,0,0,28">
                <StackPanel>
                    <Grid Background="{StaticResource RowAltBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="НАЗВА" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="1" Text="ФАЙЛ" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="2" Text="ЗАВАНТАЖЕНО" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="3" Text="МІТОК" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="4" Text="" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DocxTemplates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLineBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Grid, а не StackPanel: інакше довга назва виштовхує плашку
                                                 за межі колонки (та сама причина, що в рядку Excel-шаблону). -->
                                            <Grid Grid.Column="0" Margin="20,13" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" Padding="6,2"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsFromBuilder, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Конструктор" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding OriginalFileName}" Margin="20,13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UploadedAtDisplay}" Margin="20,13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TagCount}" Margin="20,13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,13">
                                                <!-- Лише для зібраних конструктором: розібрати завантажений
                                                     .docx назад у блоки неможливо. -->
                                                <Button Content="&#xE8A5;" Style="{StaticResource RowIconButtonStyle}"
                                                        ToolTip="Відкрити в конструкторі"
                                                        Visibility="{Binding IsFromBuilder, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.EditWithBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="&#xE70F;" Style="{StaticResource RowIconButtonStyle}" ToolTip="Переглянути мапінг" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="&#xE74D;" Style="{StaticResource RowIconButtonStyle}" ToolTip="Видалити" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DeleteDocxTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Excel-шаблони з {{тегами}} — той самий розділ, той самий рядок,
                         шаблон рядка береться з ресурсів за типом елемента. -->
                    <ItemsControl ItemsSource="{Binding DocumentExcelTemplates}"/>

                    <StackPanel Orientation="Horizontal" Margin="20,16">
                        <Button Content="+ Завантажити шаблон" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding UploadDocxTemplateCommand}"/>
                        <!-- Другий спосіб отримати шаблон: скласти з блоків, не редагуючи .docx руками. -->
                        <Button Content="+ Зібрати шаблон" Margin="8,0,0,0"
                                ToolTip="Документ Word з блоків"
                                Command="{Binding CreateWithBuilderCommand}"/>
                        <Button Content="+ Зібрати відомість" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Відомість Excel: заголовок, колонки, підписи"
                                Command="{Binding CreateVidomistWithBuilderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Шаблони експорту списків" Style="{StaticResource TemplatesSectionTitleStyle}"/>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="1" CornerRadius="0">
                <StackPanel>
                    <Grid Background="{StaticResource RowAltBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="НАЗВА" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="1" Text="ФАЙЛ" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="2" Text="ЗАВАНТАЖЕНО" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="3" Text="МІТОК" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                        <TextBlock Grid.Column="4" Text="" Style="{StaticResource TemplatesHeaderTextStyle}" Margin="20,13"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ListExportTemplates}"/>

                    <Button Content="+ Завантажити шаблон" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding UploadTemplateCommand}" HorizontalAlignment="Left" Margin="20,16"/>
                </StackPanel>
            </Border>

        </StackPanel>

            <!-- З'являється лише після кліку на олівець у рядку; поки шаблон не обрано,
                 панелі немає взагалі, щоб порожня картка не займала місце.
                 Ширина — Auto (по вмісту) з межами, доки не потягнули роздільник. -->
            <!-- MaxWidth 560, а не «скільки хоче вміст»: Grid віддає Auto-колонці
                 бажану ширину навіть коли її нема куди подіти, і панель просто
                 вилазила за край екрана (колонка «Поле» обрізалась). 560 + мінімум
                 переліку вміщається навіть у вузьке вікно; ширше — роздільником. -->
            <Border Grid.Column="1" Margin="18,0,0,0"
                    MinWidth="320" MaxWidth="460"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasSelectedTemplate, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>

                    <!-- Роздільник: тягнеться вліво, розширюючи панель за рахунок переліків -->
                    <Thumb DockPanel.Dock="Left" Width="6" Cursor="SizeWE"
                           DragDelta="MappingResizeThumb_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderLineBrush}"
                                        BorderThickness="0,0,1,0"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <StackPanel>
                    <Border Background="{StaticResource RowAltBrush}" Padding="20,13">
                        <Grid>
                            <TextBlock Text="МАПІНГ ОБРАНОГО ШАБЛОНА" VerticalAlignment="Center"
                                       Style="{StaticResource TemplatesHeaderTextStyle}"/>
                            <Button Content="&#xE711;" Style="{StaticResource RowIconButtonStyle}"
                                    ToolTip="Закрити" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding ClearTemplateSelectionCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Видимість задана явно: ContentControl із ContentTemplate малює
                         шаблон і при Content = null, тож для Excel-шаблона поверх
                         справжнього мапінгу з'являвся порожній Word-редактор. -->
                    <ContentControl Content="{Binding SelectedDocxTemplate}"
                                    ContentTemplate="{StaticResource DocxMappingEditorTemplate}"
                                    Visibility="{Binding HasSelectedDocxTemplate, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,12,0,0"/>
                    <ContentControl Content="{Binding SelectedExportTemplate}"
                                    ContentTemplate="{StaticResource ExportMappingEditorTemplate}"
                                    Visibility="{Binding HasSelectedExportTemplate, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,12,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
